<odoo>
    <!-- TREE -->
    <record id="view_project_list" model="ir.ui.view">
        <field name="name">project.list</field>
        <field name="model">task.project</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- FORM -->
    <record id="view_project_form" model="ir.ui.view">
        <field name="name">project.form</field>
        <field name="model">task.project</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                    <notebook>
                        <page string="Tasks">
                            <field name="task_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="user_id"/>
                                    <field name="deadline"/>
                                    <field name="status"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_project" model="ir.actions.act_window">
        <field name="name">Project</field>
        <field name="res_model">task.project</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- MENU -->
    <menuitem id="menu_project" name="Projects" parent="menu_task_root" action="action_project" sequence="20"/>
</odoo>