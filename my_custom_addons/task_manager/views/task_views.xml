<odoo>
    <!-- TREE -->
    <record id="view_task_list" model="ir.ui.view">
        <field name="name">task.list</field>
        <field name="model">task.manager</field>
        <field name="arch" type="xml">
            <list decoration-success="status == 'done'"
            decoration-warning="status == 'in_progress'"
            decoration-danger="status == 'todo'">
                <field name="name"/>
                <field name="project_id"/>
                <field name="user_id"/>
                <field name="deadline"/>
                <field name="status" widget="badge" decoration-success="status == 'done'" decoration-warning="status == 'in_progress'" decoration-info="status == 'todo'"/>
            </list>
        </field>
    </record>

    <record id="view_task_form" model="ir.ui.view">
        <field name="name">task.form</field>
        <field name="model">task.manager</field>
        <field name="arch" type="xml">
            <form>
            <header>
                <field name="status"
                        widget="statusbar"
                        options="{'clickable': True}"
                        statusbar_visible="todo,in_progress,done"/>
            </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="project_id"/>
                        <field name="user_id"/>
                        <field name="deadline"/>
                        <field name="status" groups="base.group_no_one"/>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- action -->
    <record id="action_task" model="ir.actions.act_window">
        <field name="name">Task Manager</field>
        <field name="res_model">task.manager</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- menu -->
    <menuitem id="menu_task_root" name="Task Manager" sequence="10"/>
    <menuitem id="menu_task" name="Tasks" parent="menu_task_root" action="action_task" sequence="10"/>
</odoo>