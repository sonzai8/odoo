<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dl_salary_kpi_export_loader_form" model="ir.ui.view">
        <field name="name">dl.salary.kpi.export.loading.form</field>
        <field name="model">dl.salary.kpi.export.loading</field>
        <field name="arch" type="xml">
            <form string="Đang chuẩn bị báo cáo">
                <sheet>
                    <div class="text-center">
                        <h3 class="mt-4">Đang chuẩn bị dữ liệu báo cáo...</h3>
                        <p class="text-muted">Hệ thống đang trích xuất dữ liệu và tạo file Excel. Quá trình này có thể mất vài giây do dung lượng template lớn.</p>
                        <p>Vui lòng bấm nút dưới đây để bắt đầu tải xuống.</p>
                    </div>
                    <footer>
                        <button name="action_download" string="Tải báo cáo ngay" type="object" class="btn-primary" icon="fa-download"/>
                        <button string="Đóng" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
