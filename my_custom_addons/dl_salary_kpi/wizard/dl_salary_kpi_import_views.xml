<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dl_salary_kpi_import_wizard_form" model="ir.ui.view">
        <field name="name">dl.salary.kpi.import.wizard.form</field>
        <field name="model">dl.salary.kpi.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Nhập bảng công từ Excel">
                <sheet>
                    <field name="state" invisible="1"/>
                    <field name="has_anomalies" invisible="1"/>
                    
                    <group invisible="state != 'upload'">
                        <field name="month_id" invisible="1"/>
                        <field name="wizard_type" readonly="1" options="{'horizontal': True}"/>
                        <label for="file_data" string="1. Xuất dữ liệu / Tải file mẫu"/>
                        <div class="o_row">
                            <button name="action_export" string="Bấm để Tải file Công hiện tại" type="object" class="btn-link" icon="fa-download"/>
                        </div>
                        <separator string="2. Nhập dữ liệu từ file đã sửa"/>
                        <field name="file_data" filename="file_name" string="Chọn file Excel"/>
                        <field name="file_name" invisible="1"/>

                        
                        <separator string="3. Nhập dữ liệu từ file chấm công nội bộ"/>
                        <label for="action_import_internal_placeholder" string="Chọn file công nội bộ"/>
                        <div>
                            <button name="action_import_internal_placeholder" string="Tải lên tập tin của bạn" type="object" class="btn-secondary" icon="fa-upload"/>
                        </div>
                        
                    </group>

                    <notebook invisible="state != 'preview'">
                        <page string="✅ Dữ liệu hợp lệ">
                            <field name="preview_valid_html" widget="html" nolabel="1"/>
                        </page>
                        <page string="⚠️ Dữ liệu bất thường">
                            <field name="preview_anomaly_html" widget="html" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_analyze" string="🔍 Phân tích dữ liệu" type="object" class="btn-primary" invisible="not file_data or state != 'upload'"/>
                    
                    <button name="action_import" string="✅ Xác nhận Upload" type="object" class="btn-primary" 
                            invisible="state != 'preview'" 
                            confirm="Bạn chắc chắn muốn lưu các dữ liệu hợp lệ và ghi đè vào bảng công hiện tại?"/>
                    <button name="action_back" string="⬅️ Quay lại" type="object" class="btn-secondary" invisible="state != 'preview'"/>
                    
                    <button string="Đóng" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
