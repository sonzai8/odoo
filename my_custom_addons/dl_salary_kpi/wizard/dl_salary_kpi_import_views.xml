<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dl_salary_kpi_import_wizard_form" model="ir.ui.view">
        <field name="name">dl.salary.kpi.import.wizard.form</field>
        <field name="model">dl.salary.kpi.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Nhập bảng công từ Excel">
                <group>
                    <field name="month_id" invisible="1"/>
                    <field name="file_data" filename="file_name"/>
                    <field name="file_name" invisible="1"/>
                </group>
                <footer>
                    <button name="action_import" string="Nhập dữ liệu" type="object" class="btn-primary"/>
                    <button string="Hủy" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
