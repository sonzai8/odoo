<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dl_salary_kpi_quick_fix_wizard_form" model="ir.ui.view">
        <field name="name">dl.salary.kpi.quick.fix.wizard.form</field>
        <field name="model">dl.salary.kpi.quick.fix.wizard</field>
        <field name="arch" type="xml">
            <form string="Điều chỉnh công">
                <group>
                    <group string="📋 Thông tin nhân viên">
                        <field name="line_id" invisible="1"/>
                        <field name="employee_name" string="Nhân viên"/>
                        <field name="identification_id" string="Số CCCD"/>
                        <field name="current_lk" widget="monetary" options="{'currency_field': 'currency_id'}" string="Thực lĩnh ngoài(TLN)"/>
                        <field name="target_salary" widget="monetary" options="{'currency_field': 'currency_id'}" string="Lương trong (Ln)"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <group string="📊 Gợi ý xử lý">
                        <field name="suggestion_html" nolabel="1" colspan="2"/>
                    </group>
                </group>
                <div class="alert alert-info" role="alert" style="margin-bottom: 10px;">
                    <i class="fa fa-info-circle" title="Thông tin"/> <b>Hướng dẫn nhập:</b> Nhập số <b>DƯƠNG</b> (VD: 2) để <b>THÊM</b> công, nhập số <b>ÂM</b> (VD: -2) để <b>GIẢM</b> công. Hệ thống sẽ tự động tìm ngày phù hợp để điều chỉnh.
                </div>
                <group>
                    <group string="🔧 Điều chỉnh công chính (N, Đ)">
                        <div class="d-flex align-items-center gap-2">
                            <label for="change_n" string="Công N (+/-)" class="fw-bold"/>
                            <field name="change_n" type="number" nolabel="1" class="oe_inline" style="width: 60px;"/>
                            <span class="text-muted">/ Tồn tại: </span>
                            <field name="current_n" nolabel="1" class="oe_inline text-primary fw-bold" readonly="1"/>
                        </div>
                        <div class="d-flex align-items-center gap-2 mt-2">
                            <label for="change_d" string="Công Đ (+/-)" class="fw-bold"/>
                            <field name="change_d" type="number" nolabel="1" class="oe_inline" style="width: 60px;"/>
                            <span class="text-muted">/ Tồn tại: </span>
                            <field name="current_d" nolabel="1" class="oe_inline text-primary fw-bold" readonly="1"/>
                        </div>
                    </group>
                    <group string="🔧 Điều chỉnh OT (0.5N, 0.5Đ)">
                        <div class="d-flex align-items-center gap-2">
                            <label for="change_ot_n" string="Công 0.5N (+/-)" class="fw-bold"/>
                            <field name="change_ot_n" type="number" nolabel="1" class="oe_inline" style="width: 60px;"/>
                            <span class="text-muted">/ Tồn tại: </span>
                            <field name="current_ot_n" nolabel="1" class="oe_inline text-primary fw-bold" readonly="1"/>
                        </div>
                        <div class="d-flex align-items-center gap-2 mt-2">
                            <label for="change_ot_d" string="Công 0.5Đ (+/-)" class="fw-bold"/>
                            <field name="change_ot_d" type="number" nolabel="1" class="oe_inline" style="width: 60px;"/>
                            <span class="text-muted">/ Tồn tại: </span>
                            <field name="current_ot_d" nolabel="1" class="oe_inline text-primary fw-bold" readonly="1"/>
                        </div>
                    </group>
                </group>
                <footer>
                    <button name="action_apply_quick_fix" string="Xác nhận điều chỉnh" type="object" class="btn-primary" icon="fa-check"/>
                    <button string="Hủy" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
