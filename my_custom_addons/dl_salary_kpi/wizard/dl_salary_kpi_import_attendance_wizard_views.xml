<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dl_salary_kpi_import_attendance_wizard_form" model="ir.ui.view">
        <field name="name">dl.salary.kpi.import.attendance.wizard.form</field>
        <field name="model">dl.salary.kpi.import.attendance.wizard</field>
        <field name="arch" type="xml">
            <form string="Nhập chấm công từ Excel">
                <group>
                    <field name="month_id" readonly="1"/>
                    <field name="file_data" filename="file_name"/>
                    <field name="file_name" invisible="1"/>
                </group>
                <footer>
                    <button name="action_import" string="Nhập dữ liệu" type="object" class="btn-primary"/>
                    <button string="Hủy" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_dl_salary_kpi_import_attendance_wizard" model="ir.actions.act_window">
        <field name="name">Nhập chấm công KPI</field>
        <field name="res_model">dl.salary.kpi.import.attendance.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
