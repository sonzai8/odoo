<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dl_salary_kpi_export_wizard_form" model="ir.ui.view">
        <field name="name">dl.salary.kpi.export.wizard.form</field>
        <field name="model">dl.salary.kpi.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Xuất bảng lương &amp; KPI">
                <group>
                    <field name="month_id" options="{'no_create': True, 'no_open': True}"/>
                </group>
                <footer>
                    <button name="action_export_xlsx" string="Xuất Excel" type="object" class="btn-primary"/>
                    <button string="Hủy" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_dl_salary_kpi_export_wizard" model="ir.actions.act_window">
        <field name="name">Xuất bảng lương &amp; KPI</field>
        <field name="res_model">dl.salary.kpi.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
