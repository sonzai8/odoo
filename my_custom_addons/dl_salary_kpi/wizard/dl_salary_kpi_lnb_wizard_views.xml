<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dl_salary_kpi_lnb_wizard_form" model="ir.ui.view">
        <field name="name">dl.salary.kpi.lnb.wizard.form</field>
        <field name="model">dl.salary.kpi.lnb.wizard</field>
        <field name="arch" type="xml">
            <form string="Sửa nhanh Lương Nội Bộ (LNB)">
                <group>
                    <group>
                        <field name="employee_name"/>
                        <field name="identification_id"/>
                    </group>
                    <group>
                        <field name="current_lnb" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        <field name="new_lnb" widget="monetary" options="{'currency_field': 'currency_id'}" class="oe_inline"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                </group>
                <footer>
                    <button name="action_apply" string="Cập nhật LNB" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Hủy" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_dl_salary_kpi_lnb_wizard" model="ir.actions.act_window">
        <field name="name">Sửa nhanh Lương Nội Bộ (LNB)</field>
        <field name="res_model">dl.salary.kpi.lnb.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
