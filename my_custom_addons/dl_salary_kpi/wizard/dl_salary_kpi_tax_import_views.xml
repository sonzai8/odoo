<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dl_salary_kpi_tax_import_form" model="ir.ui.view">
        <field name="name">dl.salary.kpi.tax.import.form</field>
        <field name="model">dl.salary.kpi.tax.import</field>
        <field name="arch" type="xml">
            <form string="Quản lý nhập nhân viên thuế">
                <header>
                    <button name="action_export_template" string="Tải file mẫu (Toàn bộ NV)" type="object" class="btn-success" icon="fa-download" invisible="state != 'upload'"/>
                    <field name="state" widget="statusbar" invisible="1"/>
                </header>
                <sheet>
                    <div invisible="state != 'upload'">
                        <group>
                            <field name="file_data" filename="file_name"/>
                            <field name="file_name" invisible="1"/>
                        </group>
                    </div>
                    <div invisible="state != 'verify'">
                        <div class="alert alert-info" role="alert" invisible="has_errors">
                            Vui lòng kiểm tra lại thông tin bên dưới trước khi xác nhận nhập liệu. 
                            Hệ thống hiển thị tối đa 5 bản ghi đầu và 5 bản ghi cuối để tối ưu hiệu năng.
                            <br/><strong>Tổng số bản ghi sẽ nhập: <field name="total_records" readonly="1" class="oe_inline"/></strong>
                        </div>
                        <div class="alert alert-danger" role="alert" invisible="not has_errors">
                            <strong>Phát hiện lỗi trong file!</strong> Vui lòng kiểm tra danh sách bên dưới hoặc tóm tắt lỗi để xử lý.
                            <br/><strong>Tổng số bản ghi: <field name="total_records" readonly="1" class="oe_inline"/></strong>
                        </div>
                        <group invisible="not error_summary">
                            <field name="error_summary" readonly="1" nolabel="1" class="text-danger"/>
                        </group>
                        <field name="has_errors" invisible="1"/>
                        <field name="line_ids">
                            <list decoration-danger="error_msg != ''">
                                <field name="employee_id" optional="show"/>
                                <field name="name" width="150px"/>
                                <field name="dl_first_name"/>
                                <field name="identification_id" width="100px"/>
                                <field name="dl_tax_id"/>
                                <field name="dl_tax_position" width="120px"/>
                                <field name="dl_tax_department_name"/>
                                <field name="dl_tax_base_salary"/>
                                <field name="import_type" widget="badge" decoration-info="import_type == 'insert'" decoration-warning="import_type == 'update'"/>
                                <field name="birthday" optional="show"/>
                                <field name="dl_departure_date" optional="show"/>
                                <field name="error_msg" widget="badge" decoration-danger="error_msg != ''" invisible="error_msg == ''"/>
                                <field name="email" optional="hide" width="30px"/>
                            </list>
                        </field>
                    </div>
                </sheet>
                <footer>
                    <button name="action_verify" string="Tiếp theo (Kiểm tra)" type="object" class="btn-primary" invisible="state != 'upload'"/>
                    <button name="action_confirm_import" string="Xác nhận nhập" type="object" class="btn-primary" invisible="state != 'verify'"/>
                    <button string="Hủy" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_dl_salary_kpi_tax_import" model="ir.actions.act_window">
        <field name="name">Nhập nhân viên thuế</field>
        <field name="res_model">dl.salary.kpi.tax.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
