    <record id="view_dl_salary_kpi_line_search" model="ir.ui.view">
        <field name="name">dl.salary.kpi.line.search</field>
        <field name="model">dl.salary.kpi.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="identification_id"/>
                <field name="month_id"/>
                <field name="dl_tax_department"/>

                <filter string="Có nghỉ phép (P)" name="has_p" domain="[('total_p', '>', 0)]"/>
                <filter string="Có không phép (KP)" name="has_kp" domain="[('total_kp', '>', 0)]"/>
                <filter string="Có nghỉ ốm (Ô)" name="has_o" domain="[('total_o', '>', 0)]"/>
                <filter string="Có con ốm (CÔ)" name="has_co" domain="[('total_co', '>', 0)]"/>
                <filter string="Có đổi ca (ĐC)" name="has_dc" domain="[('total_dc', '>', 0)]"/>

                <separator/>
                <filter string="Tháng" name="group_month" context="{'group_by': 'month_id'}"/>
                <filter string="Phòng ban" name="group_dept" context="{'group_by': 'dl_tax_department'}"/>

                <searchpanel>
                    <field name="month_id" icon="fa-calendar" enable_counters="1"/>
                    <field name="attendance_type_ids" string="Mã chấm công" select="multi" icon="fa-tags" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="view_dl_salary_kpi_line_list" model="ir.ui.view">
        <field name="name">dl.salary.kpi.line.list</field>
        <field name="model">dl.salary.kpi.line</field>
        <field name="arch" type="xml">
            <list string="Chi tiết công" decoration-danger="total_kp > 0" decoration-warning="total_o > 0">
                <field name="month_id" width="180px"/>
                <field name="employee_id" width="110px"/>
                <field name="dl_tax_department" width="70px"/>
                <field name="total_n" sum="Tổng N"/>
                <field name="total_d" sum="Tổng Đ"/>
                <field name="total_p" sum="Tổng P"/>
                <field name="total_kp" sum="Tổng KP" />
                <field name="total_o" sum="Tổng Ô"/>
                <field name="total_dc" sum="Tổng ĐC"/>
                <field name="total_co" sum="Tổng CÔ"/>
                <field name="total_ot_n" sum="Tổng TC Ngày" optional="show"/>
                <field name="total_ot_d" sum="Tổng TC Đêm" optional="show"/>
                <field name="total_ot_all" sum="Tổng Cộng TC" decoration-danger="1" optional="show"/>
                <field name="attendance_type_ids" widget="many2many_tags" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_dl_salary_kpi_line_detail" model="ir.actions.act_window">
        <field name="name">Chi tiết chấm công nhân viên</field>
