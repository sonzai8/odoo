        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_dl_salary_kpi_line_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Bảng này hiển thị chi tiết các mã công của từng nhân viên.
