                                    <field name="day_18_is_sunday" column_invisible="1"/>
                                    <field name="day_19_is_sunday" column_invisible="1"/>
                                    <field name="day_20_is_sunday" column_invisible="1"/>
                                    <field name="day_21_is_sunday" column_invisible="1"/>
                                    <field name="day_22_is_sunday" column_invisible="1"/>
