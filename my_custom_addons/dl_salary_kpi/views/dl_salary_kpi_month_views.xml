                                    <field name="day_17" string="17" widget="badge" decoration-info="day_17_is_sunday"/>
                                    <field name="day_18" string="18" widget="badge" decoration-info="day_18_is_sunday"/>
                                    <field name="day_19" string="19" widget="badge" decoration-info="day_19_is_sunday"/>
                                    <field name="day_20" string="20" widget="badge" decoration-info="day_20_is_sunday"/>
                                    <field name="day_21" string="21" widget="badge" decoration-info="day_21_is_sunday"/>
                                    <field name="day_22" string="22" widget="badge" decoration-info="day_22_is_sunday"/>
                                    <field name="day_23" string="23" widget="badge" decoration-info="day_23_is_sunday"/>
