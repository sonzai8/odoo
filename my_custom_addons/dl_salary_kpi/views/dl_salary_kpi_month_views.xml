<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dl_salary_kpi_month_tree" model="ir.ui.view">
        <field name="name">dl.salary.kpi.month.tree</field>
        <field name="model">dl.salary.kpi.month</field>
        <field name="arch" type="xml">
            <list string="Cân đối bảng công">
                <field name="date_month"/>
                <field name="name"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'confirmed'"/>
            </list>
        </field>
    </record>

    <record id="view_dl_salary_kpi_month_form" model="ir.ui.view">
        <field name="name">dl.salary.kpi.month.form</field>
        <field name="model">dl.salary.kpi.month</field>
        <field name="arch" type="xml">
            <form string="Cân đối bảng công">
                <header>
                    <button name="action_export_excel" string="Xuất file công" type="object" class="btn-success" icon="fa-download"/>

                    <button name="action_import_excel" string="Nhập file công" type="object" class="btn-info" icon="fa-upload" invisible="state != 'draft'"/>
                    <button name="action_confirm" string="Xác nhận" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_draft" string="Mở lại dự thảo" type="object" invisible="state != 'confirmed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <div class="oe_stat_button" icon="fa-users">
                            <field name="total_employees" widget="statinfo" string="Nhân viên"/>
                        </div>
                        <div class="oe_stat_button" icon="fa-sun-o" font-color="orange">
                            <field name="total_n" widget="statinfo" string="Công Ngày"/>
                        </div>
                        <div class="oe_stat_button" icon="fa-moon-o" font-color="blue">
                            <field name="total_d" widget="statinfo" string="Công Đêm"/>
                        </div>
                        <div class="oe_stat_button" icon="fa-plane" font-color="green">
                            <field name="total_p" widget="statinfo" string="Phép (P)"/>
                        </div>
                        <div class="oe_stat_button" icon="fa-star" font-color="red">
                            <field name="total_pl" widget="statinfo" string="Lễ (PL)"/>
                        </div>
                        <div class="oe_stat_button" icon="fa-exclamation-triangle" font-color="red">
                            <field name="total_kp" widget="statinfo" string="Không phép"/>
                        </div>
                        <div class="oe_stat_button" icon="fa-medkit" font-color="brown">
                            <field name="total_o" widget="statinfo" string="Nghỉ ốm"/>
                        </div>
                        <div class="oe_stat_button" icon="fa-exchange" font-color="purple">
                            <field name="total_dc" widget="statinfo" string="Điều chuyển"/>
                        </div>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date_month" readonly="state != 'draft'"/>
                        </group>
    
                    </group>
                    <notebook>
                        <page string="Bảng công Ma trận" name="matrix">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="employee_name" readonly="1" sticky="1" width="180px"/>
                                    <field name="dl_tax_department" readonly="1" sticky="1"/>
                                    <field name="dl_tax_position" readonly="1" sticky="1"/>
                                    
                                    <field name="day_01_is_sunday" column_invisible="1"/>
                                    <field name="day_02_is_sunday" column_invisible="1"/>
                                    <field name="day_03_is_sunday" column_invisible="1"/>
                                    <field name="day_04_is_sunday" column_invisible="1"/>
                                    <field name="day_05_is_sunday" column_invisible="1"/>
                                    <field name="day_06_is_sunday" column_invisible="1"/>
                                    <field name="day_07_is_sunday" column_invisible="1"/>
                                    <field name="day_08_is_sunday" column_invisible="1"/>
                                    <field name="day_09_is_sunday" column_invisible="1"/>
                                    <field name="day_10_is_sunday" column_invisible="1"/>
