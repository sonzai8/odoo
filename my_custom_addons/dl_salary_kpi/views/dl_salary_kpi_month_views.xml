                                    <field name="day_30" string="30" widget="badge" decoration-info="day_30_is_sunday"/>
                                    <field name="day_31" string="31" widget="badge" decoration-info="day_31_is_sunday"/>
                                </list>

                            </field>
                        </page>
                        <page string="Thống kê">
                        </page>

                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dl_salary_kpi_month" model="ir.actions.act_window">
        <field name="name">Cân đối bảng công</field>
        <field name="res_model">dl.salary.kpi.month</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Bấm để tạo đợt cân đối bảng công mới.
