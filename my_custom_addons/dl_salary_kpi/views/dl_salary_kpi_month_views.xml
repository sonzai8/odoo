                    <button name="action_import_ot_excel" string="Nhập/Xuất Công Làm Thêm" type="object" class="btn-warning" icon="fa-clock-o" invisible="state != 'lock_normal'"/>
                    
                    <button name="action_lock_normal" string="Chốt công Thường" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_lock_ot" string="Chốt Công Làm thêm" type="object" class="btn-primary" invisible="state != 'lock_normal'"/>
                    <button name="action_lock_regime" string="Chốt Chế Độ" type="object" class="btn-primary" invisible="state != 'lock_ot'"/>
                    <button name="action_lock_kpi" string="Chốt KPI" type="object" class="btn-primary" invisible="state != 'lock_regime'"/>
                    <button name="action_confirm" string="Xác nhận" type="object" class="btn-success" invisible="state != 'lock_kpi'"/>
                    
                    <button name="action_back_to_draft" string="Quay lại Dự thảo" type="object" invisible="state != 'lock_normal'"/>
                    <button name="action_back_to_lock_normal" string="Quay lại Công Thường" type="object" invisible="state != 'lock_ot'"/>
                    <button name="action_back_to_lock_ot" string="Quay lại Làm Thêm" type="object" invisible="state != 'lock_regime'"/>
                    <button name="action_back_to_lock_regime" string="Quay lại Chế Độ" type="object" invisible="state != 'lock_kpi'"/>
                    <button name="action_back_to_lock_kpi" string="Quay lại KPI" type="object" invisible="state != 'confirmed'"/>
                    
                    <field name="state" widget="statusbar" statusbar_visible="draft,lock_normal,lock_ot,lock_regime,lock_kpi,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <div class="oe_stat_button" icon="fa-users">
                            <field name="total_employees" widget="statinfo" string="Nhân viên"/>
                        </div>
                        <div class="oe_stat_button" icon="fa-sun-o" font-color="orange">
                            <field name="total_n" widget="statinfo" string="Ngày"/>
                        </div>
                        <div class="oe_stat_button" icon="fa-moon-o" font-color="blue">
                            <field name="total_d" widget="statinfo" string="Đêm"/>
                        </div>
                        <div class="oe_stat_button" icon="fa-plane" font-color="green">
                            <field name="total_p" widget="statinfo" string="Phép (P)"/>
                        </div>
                        <div class="oe_stat_button" icon="fa-star" font-color="red">
                            <field name="total_pl" widget="statinfo" string="Phép lễ"/>
                        </div>
                        <div class="oe_stat_button" icon="fa-exclamation-triangle" font-color="red">
                            <field name="total_kp" widget="statinfo" string="Không phép"/>
                        </div>
                        <div class="oe_stat_button" icon="fa-medkit" font-color="brown">
                            <field name="total_o" widget="statinfo" string="Nghỉ ốm"/>
