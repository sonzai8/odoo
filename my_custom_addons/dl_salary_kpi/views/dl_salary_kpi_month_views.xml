<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dl_salary_kpi_month_tree" model="ir.ui.view">
        <field name="name">dl.salary.kpi.month.tree</field>
        <field name="model">dl.salary.kpi.month</field>
        <field name="arch" type="xml">
            <list string="Cân đối bảng công">
                <field name="date_month"/>
                <field name="name"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'confirmed'"/>
            </list>
        </field>
    </record>

