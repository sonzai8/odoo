<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dl_salary_kpi_employee_tree" model="ir.ui.view">
        <field name="name">dl.salary.kpi.employee.tree</field>
        <field name="model">dl.salary.kpi.employee</field>
        <field name="arch" type="xml">
            <list string="Nhân viên KPI">
                <header>
                    <button name="action_sync_from_hr" string="Đồng bộ từ HR" type="object" class="oe_highlight"/>
                </header>
                <field name="name"/>
                <field name="gender"/>
                <field name="identification_id"/>
                <field name="department_id"/>
                <field name="work_group_id"/>
                <field name="default_att_type_id"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_dl_salary_kpi_employee_form" model="ir.ui.view">
        <field name="name">dl.salary.kpi.employee.form</field>
        <field name="model">dl.salary.kpi.employee</field>
        <field name="arch" type="xml">
            <form string="Nhân viên KPI">
                <header>
                    <button name="action_sync_from_hr" string="Đồng bộ từ HR" type="object" class="oe_highlight"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Họ và tên"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="gender"/>
                            <field name="identification_id"/>
                            <field name="default_att_type_id"/>
                        </group>
                        <group>
                            <field name="department_id"/>
                            <field name="work_group_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dl_salary_kpi_employee" model="ir.actions.act_window">
        <field name="name">Quản lý Nhân viên KPI</field>
        <field name="res_model">dl.salary.kpi.employee</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Bấm để tạo nhân viên KPI mới.
            </p>
        </field>
    </record>
</odoo>
