<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dl_salary_kpi_attendance_type_tree" model="ir.ui.view">
        <field name="name">dl.salary.kpi.attendance.type.tree</field>
        <field name="model">dl.salary.kpi.attendance.type</field>
        <field name="arch" type="xml">
            <list string="Loại công KPI" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="num_work"/>
                <field name="day_hour"/>
                <field name="night_hour"/>
                <field name="default_overtime"/>
            </list>
        </field>
    </record>

    <record id="action_dl_salary_kpi_attendance_type" model="ir.actions.act_window">
        <field name="name">Cấu hình Loại công</field>
        <field name="res_model">dl.salary.kpi.attendance.type</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Bấm để tạo loại công mới.
            </p>
        </field>
    </record>
</odoo>
