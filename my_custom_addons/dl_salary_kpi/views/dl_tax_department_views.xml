<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dl_tax_department_tree" model="ir.ui.view">
        <field name="name">dl.tax.department.list</field>
        <field name="model">dl.tax.department</field>
        <field name="arch" type="xml">
            <list limit="20" string="Phòng ban thuế" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="company_id"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_dl_tax_department_form" model="ir.ui.view">
        <field name="name">dl.tax.department.form</field>
        <field name="model">dl.tax.department</field>
        <field name="arch" type="xml">
            <form string="Phòng ban thuế">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="company_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dl_tax_department" model="ir.actions.act_window">
        <field name="name">Cấu hình phòng ban thuế</field>
        <field name="res_model">dl.tax.department</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('company_id', 'in', allowed_company_ids)]</field>
        <field name="context">{'default_company_id': allowed_company_ids[0]}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo mới phòng ban thuế tại đây.
            </p>
        </field>
    </record>

    <!-- Menu được định nghĩa trong menus.xml -->
</odoo>
