<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_dl_dependent_list" model="ir.ui.view">
        <field name="name">dl.dependent.list</field>
        <field name="model">dl.dependent</field>
        <field name="arch" type="xml">
            <list limit="20" string="Người phụ thuộc" editable="bottom">
                <header>
                    <button name="%(action_dl_dependent_import)d" string="Nhập từ Excel" type="action" class="btn-primary"/>
                    <button name="action_export_excel" string="Xuất Excel" type="object" class="btn-secondary"/>
                </header>
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="employee_tax_id"/>
                <field name="employee_tax_department_id"/>
                <field name="employee_tax_position"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="name"/>
                <field name="relationship"/>
                <field name="dependent_number"/>
                <field name="dependent_id_card"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_dl_dependent_form" model="ir.ui.view">
        <field name="name">dl.dependent.form</field>
        <field name="model">dl.dependent</field>
        <field name="arch" type="xml">
            <form string="Người phụ thuộc">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Ví dụ: Nguyễn Văn A"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Nhân viên">
                            <field name="employee_id" options="{'no_create': True}"/>
                            <field name="employee_tax_id"/>
                            <field name="employee_tax_department_id"/>
                            <field name="employee_tax_position"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Người phụ thuộc">
                            <field name="relationship"/>
                            <field name="birthday"/>
                            <field name="dependent_number" placeholder="Mã số thuế"/>
                            <field name="dependent_id_card" placeholder="Căn cước công dân"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="4 - Ghi chú" name="notes">
                            <field name="note" placeholder="Thông tin bổ sung..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_dl_dependent_search_v2" model="ir.ui.view">
        <field name="name">dl.dependent.search</field>
        <field name="model">dl.dependent</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Tên người phụ thuộc"/>
                <field name="employee_id" string="Nhân viên"/>
                <field name="employee_tax_id" string="MST Nhân viên"/>
                <field name="employee_tax_position" string="Chức vụ thuế"/>
                <field name="dependent_number" string="MST Người phụ thuộc"/>
                <separator/>
                <filter string="Lưu trữ" name="inactive" domain="[('active', '=', False)]"/>
                <searchpanel>
                    <field name="employee_tax_department_id" icon="fa-building" enable_counters="1"/>
                    <field name="company_id" groups="base.group_multi_company" icon="fa-university" enable_counters="1"/>
                    <field name="relationship" icon="fa-users" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_dl_dependent" model="ir.actions.act_window">
        <field name="name">Người phụ thuộc</field>
        <field name="res_model">dl.dependent</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_dl_dependent_list"/>
        <field name="search_view_id" ref="view_dl_dependent_search_v2"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Thêm người phụ thuộc cho nhân viên.
            </p>
            <p>
                Quản lý thông tin người thân để thực hiện giảm trừ gia cảnh khi tính thuế thu nhập cá nhân.
            </p>
        </field>
    </record>

    <!-- Action URL for Export Menu -->
    <record id="action_dl_dependent_export" model="ir.actions.act_url">
        <field name="name">Xuất Excel NPT</field>
        <field name="url">/dl_salary_kpi/export_dependents</field>
        <field name="target">new</field>
    </record>

    <!-- Ràng buộc Form view rõ ràng -->
    <record id="action_dl_dependent_form_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_dl_dependent_form"/>
        <field name="act_window_id" ref="action_dl_dependent"/>
    </record>

    <!-- Ràng buộc List view rõ ràng -->
    <record id="action_dl_dependent_list_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_dl_dependent_list"/>
        <field name="act_window_id" ref="action_dl_dependent"/>
    </record>
</odoo>
