<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_tree_inherit_tax" model="ir.ui.view">
        <field name="name">hr.employee.tree.inherit.tax</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='work_email']" position="after">
                <field name="x_bank_account" optional="show"/>
                <field name="x_bank_name" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_employee_form_inherit_tax" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.tax</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            
            <xpath expr="//field[@name='image_1920']" position="attributes">
                <attribute name="widget">qr_employee_image</attribute>
            </xpath>

            <xpath expr="//div[hasclass('oe_title')]//h1" position="after">
                <h5 class="d-flex align-items-baseline mb-0">
                    <i class="fa fa-id-badge fa-fw me-1 text-primary" title="Tên riêng"/>
                    <field name="dl_first_name" placeholder="Tên riêng nhân viên..."/>
                </h5>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="2 - Cấu Hình Thuế" name="tax_config">
                    <group>
                        <group string="Định Danh - Ngân Hàng">
                            <field name="identification_id"/>
                            <field name="dl_tax_id"/>
                            <field name="dl_tax_department_id"/>
                            <field name="x_bank_account"/>
                            <field name="x_bank_name"/>
                        </group>
                        <group string="Thông tin lương thuế">
                            <field name="dl_tax_position"/>
                            <field name="dl_tax_base_salary"/>
                            <field name="dl_departure_date"/>
                        </group>
                    </group>
                </page>
                <page string="3 - Người phụ thuộc" name="dependents">
                    <field name="dependent_ids" nolabel="1">
                        <list limit="20" editable="bottom">
                            <field name="name"/>
                            <field name="birthday"/>
                            <field name="relationship"/>
                            <field name="dependent_number"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="active" widget="boolean_toggle"/>
                        </list>
                    </field>
                </page>
            </xpath>

        </field>
    </record>
</odoo>