<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dl_salary_kpi_notice_form" model="ir.ui.view">
        <field name="name">dl.salary.kpi.notice.form</field>
        <field name="model">dl.salary.kpi.notice</field>
        <field name="arch" type="xml">
            <form string="Thông báo" create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <field name="name" nolabel="1" readonly="1" class="oe_title" style="font-size: 24px; font-weight: bold;"/>
                        <field name="message" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dl_salary_kpi_notice" model="ir.actions.act_window">
        <field name="name">Tính KPI</field>
        <field name="res_model">dl.salary.kpi.notice</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>
</odoo>
