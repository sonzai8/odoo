<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dl_forest_owner_list" model="ir.ui.view">
        <field name="name">res.partner.forest.owner.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Chủ rừng" create="1" delete="1">
                <field name="name"/>
                <field name="x_short_name"/>
                <field name="x_cccd"/>
                <field name="phone"/>
                <field name="x_full_address" string="Địa chỉ đầy đủ"/>
                <field name="x_woodpro_id" string="ID WoodPro" readonly="1"/>
                <field name="company_id" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_partner_form_dl_wood_exploitation" model="ir.ui.view">
        <field name="name">res.partner.form.dl.wood.exploitation</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_type']" position="attributes">
                <attribute name="readonly">x_is_wood_supplier == 'supplier'</attribute>
            </xpath>
            <xpath expr="//field[@name='image_1920']" position="attributes">
                <attribute name="invisible">x_is_wood_supplier == 'owner'</attribute>
            </xpath>
            <xpath expr="//field[@name='image_1920']" position="after">
                <field name="x_qr_cccd_image" widget="qr_image" options="{'size': [180, 180]}" class="oe_avatar" style="width: 180px; height: 180px; max-width: 180px; max-height: 180px; object-fit: contain;" placeholder="Upload QR CCCD" invisible="x_is_wood_supplier != 'owner'"/>
            </xpath>
            <xpath expr="//field[@name='company_id']" position="attributes">
                <attribute name="readonly">1</attribute>
                <attribute name="invisible">0</attribute>
                <attribute name="groups"></attribute>
            </xpath>
            <xpath expr="//field[@name='website']" position="attributes">
                <attribute name="invisible">x_is_wood_supplier != False</attribute>
            </xpath>
            <xpath expr="//field[@name='category_id']" position="attributes">
                <attribute name="invisible">x_is_wood_supplier != False</attribute>
            </xpath>
            <xpath expr="//field[@name='parent_id']" position="attributes">
                <attribute name="invisible">x_is_wood_supplier != False</attribute>
            </xpath>
            <xpath expr="//field[@name='vat']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='function']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='lang']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='email']/parent::div" position="attributes">
                <attribute name="invisible">not is_company</attribute>
            </xpath>
            <xpath expr="//field[@name='street2']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='zip']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='phone']/parent::div" position="replace">
                <div class="d-flex align-items-baseline w-md-50">
                    <div class="d-flex align-items-baseline flex-grow-1 w-50">
                        <i class="fa fa-fw me-1 fa-phone text-primary" title="Phone"/>
                        <field name="phone" class="w-100" widget="phone" placeholder="Phone"/>
                    </div>
                    <div class="d-flex align-items-baseline flex-grow-1 w-50 ms-3" invisible="x_is_wood_supplier != 'owner'">
                        <i class="fa fa-fw me-1 fa-calendar text-primary" title="Ngày sinh"/>
                        <field name="x_birth_date" class="w-100" placeholder="Ngày sinh"/>
                    </div>
                </div>
            </xpath>
            <xpath expr="//div[@name='partner_address_country']/parent::div" position="after">
                <field name="x_prep_days" string="T.gian chuẩn bị" invisible="x_is_wood_supplier != 'owner'"/>
            </xpath>
            <xpath expr="//field[@name='vat']" position="after">
                <field name="x_is_wood_supplier" invisible="1"/>
                <field name="x_is_peeling_supplier" invisible="not is_company"/>
                <field name="x_short_name" invisible="not is_company"/>
                <field name="x_cccd" string="Số CCCD" invisible="not x_is_wood_supplier"/>
                <field name="x_gender" invisible="1"/>
                <field name="x_cccd_date" string="Ngày cấp" invisible="not x_is_wood_supplier"/>
                <field name="x_cccd_place" string="Nơi cấp" invisible="not x_is_wood_supplier"/>
                <field name="x_exploitation_capacity" string="N.lực khai thác" invisible="x_is_wood_supplier != 'owner'"/>
                <field name="x_identity_code" invisible="1"/>
                <field name="x_issue_date" invisible="1"/>
            </xpath>
            <xpath expr="//page[@name='contact_addresses']" position="before">
                <page string="Địa Điểm Khai Thác" name="exploitation_locations" autofocus="autofocus" invisible="x_is_wood_supplier != 'owner'">
                    <field name="x_is_wood_supplier" invisible="1"/>
                    <field name="exploitation_location_ids" options="{'no_open': True}">
                        <list>
                            <field name="is_main" widget="boolean_favorite" nolabel="1"/>
                            <field name="name"/>
                            <field name="x_area_ha" string="Diện tích (ha)"/>
                            <field name="street"/>
                            <field name="city"/>
                            <field name="state_id"/>
                            <field name="dossier_ids" widget="many2many_tags" readonly="1" string="Hồ Sơ Gỗ" context="{'dossier_show_code_only': True}"/>
                            <button name="action_edit_location" type="object" string="Sửa" icon="fa-pencil" class="btn-secondary" title="Sửa địa điểm khai thác"/>
                            <button name="action_create_dossier" type="object" string="Tạo hồ sơ" icon="fa-plus" class="btn-primary" title="Tạo mới Hồ sơ gỗ từ địa điểm này"/>
                            <field name="note"/>
                        </list>
                    </field>
                </page>
                <page string="Thông Tin Thanh Toán" name="payment_info">
                    <group>
                        <group string="Tài khoản Ngân hàng">
                            <field name="x_bank_name_id" options="{'no_open': False, 'no_create': False}"/>
                            <field name="x_bank_account_number"/>
                            <field name="x_bank_account_holder"/>
                        </group>
                    </group>
                </page>
            </xpath>
            <xpath expr="//page[@name='contact_addresses']" position="attributes">
                <attribute name="invisible">x_is_wood_supplier != False</attribute>
            </xpath>
            <xpath expr="//page[@name='contact_addresses']" position="before">
                <page string="Hồ Sơ Ván Bóc" name="peeling_dossiers" autofocus="autofocus" invisible="not x_is_peeling_supplier">
                    <field name="x_is_peeling_supplier" invisible="1"/>
                    <button name="action_create_peeling_dossier" type="object" string="Thêm hồ sơ ván bóc" icon="fa-plus" class="btn-primary mb-2" title="Tạo mới hồ sơ ván bóc từ nhà cung cấp này"/>
                    <field name="x_peeling_dossier_ids" readonly="1">
                        <list create="0">
                            <field name="name"/>
                            <field name="x_dossier_name"/>
                            <field name="date_received"/>
                            <field name="qty_initial" sum="Tổng ban đầu"/>
                            <field name="qty_available" sum="Tổng tồn KD" decoration-success="qty_available &gt; 0" decoration-danger="qty_available == 0"/>
                            <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'using'" decoration-muted="state == 'done'"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_dl_forest_owner_search" model="ir.ui.view">
        <field name="name">res.partner.forest.owner.search</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm Đối tác">
                <field name="name"/>
                <field name="phone"/>
                <field name="x_woodpro_id"/>
                <filter string="Chủ Rừng" name="filter_forest_owner" domain="[('x_is_wood_supplier', '=', 'owner')]"/>
                <filter string="Nhà Cung Cấp" name="filter_supplier" domain="[('x_is_wood_supplier', '=', 'supplier')]"/>
                <separator/>
                <filter string="Lưu trữ" name="inactive" domain="[('active', '=', False)]"/>
                <searchpanel>
                    <field name="x_is_wood_supplier" string="Loại đối tác" select="multi" icon="fa-users"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="action_dl_wood_forest_owner" model="ir.actions.act_window">
        <field name="name">Chủ Rừng</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('x_is_wood_supplier', '=', 'owner')]</field>
        <field name="context">{'default_x_is_wood_supplier': 'owner', 'search_default_filter_forest_owner': 1}</field>
        <field name="view_id" ref="view_dl_forest_owner_list"/>
        <field name="search_view_id" ref="view_dl_forest_owner_search"/>
    </record>

    <record id="action_dl_wood_supplier" model="ir.actions.act_window">
        <field name="name">Nhà Cung Cấp Gỗ</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('x_is_wood_supplier', '=', 'supplier')]</field>
        <field name="context">{'default_x_is_wood_supplier': 'supplier', 'search_default_filter_supplier': 1, 'default_company_type': 'company', 'default_is_company': True}</field>
        <field name="view_id" ref="view_dl_forest_owner_list"/>
        <field name="search_view_id" ref="view_dl_forest_owner_search"/>
    </record>

    <record id="action_dl_wood_peeling_supplier" model="ir.actions.act_window">
        <field name="name">Nhà Cung Cấp Ván Bóc</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('x_is_peeling_supplier', '=', True)]</field>
        <field name="context">{'default_x_is_peeling_supplier': True, 'default_is_company': True, 'default_company_type': 'company'}</field>
        <field name="view_id" ref="view_dl_forest_owner_list"/>
        <field name="search_view_id" ref="view_dl_forest_owner_search"/>
    </record>

    <!-- Menu cha gom Chủ Rừng và Nhà Cung Cấp Gỗ -->
    <menuitem id="menu_dl_wood_partners"
              name="Đối Tác"
              parent="menu_dl_wood_input_materials"
              sequence="30"/>

    <menuitem id="menu_dl_wood_forest_owner"
              name="Chủ Rừng"
              parent="menu_dl_wood_partners"
              action="action_dl_wood_forest_owner"
              sequence="10"/>
    <menuitem id="menu_dl_wood_supplier"
              name="NCC Gỗ"
              parent="menu_dl_wood_partners"
              action="action_dl_wood_supplier"
              sequence="20"/>
    <menuitem id="menu_dl_wood_peeling_supplier"
              name="NCC Ván Bóc"
              parent="menu_dl_wood_partners"
              action="action_dl_wood_peeling_supplier"
              sequence="30"/>
</odoo>
