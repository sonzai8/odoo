<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_wood_traceability" model="ir.ui.view">
        <field name="name">res.partner.form.wood.traceability</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!-- Thêm Mã khách hàng vào Form -->
            <xpath expr="//field[@name='vat']" position="before">
                <field name="x_customer_code" placeholder="Mã khách hàng phải đồng bộ với phần mềm Misa"/>
            </xpath>
            
            <notebook position="inside">
                <page string="Hợp đồng mẫu" name="contract_templates">
                    <field name="dl_contract_ids">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="file_upload" filename="file_name" string="Tải lên mẫu (.doc)"/>
                            <field name="file_name" column_invisible="1"/>
                            <field name="file_url" string="Đường dẫn trên server"/>
                            <button name="action_download_file" string="Tải về" type="object" icon="fa-download" invisible="not file_url"/>
                        </list>
                        <form>
                            <group>
                                <field name="name"/>
                                <field name="file_upload" filename="file_name"/>
                                <field name="file_name" invisible="1"/>
                                <field name="file_url" readonly="1"/>
                            </group>
                        </form>
                    </field>
                </page>
            </notebook>
        </field>
    </record>

    <!-- Kế thừa Danh sách (Tree/List) để hiển thị thêm thông tin -->
    <record id="view_partner_tree_wood_traceability" model="ir.ui.view">
        <field name="name">res.partner.list.wood.traceability</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='complete_name']" position="after">
                <field name="x_customer_code" string="Mã khách hàng"/>
                <field name="vat" string="Mã số thuế" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Action cho khách hàng -->
    <record id="action_dl_wood_customer" model="ir.actions.act_window">
        <field name="name">Khách Hàng</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('customer_rank', '>', 0)]</field>
        <field name="context">{'default_customer_rank': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo khách hàng đầu tiên!
            </p>
        </field>
    </record>

    <!-- Menu Cha: Quản Lý Khách Hàng -->
    <menuitem id="menu_dl_wood_customer_root"
              name="Quản Lý Khách Hàng"
              parent="menu_dl_wood_traceability_root"
              sequence="20"/>

    <!-- Menu Con: Danh Sách Khách Hàng -->
    <menuitem id="menu_dl_wood_customer"
              name="Danh Sách Khách Hàng"
              parent="menu_dl_wood_customer_root"
              action="action_dl_wood_customer"
              sequence="10"/>
</odoo>
