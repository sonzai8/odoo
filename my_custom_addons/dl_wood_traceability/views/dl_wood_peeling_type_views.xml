<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dl_wood_peeling_type_tree" model="ir.ui.view">
        <field name="name">dl.wood.peeling.type.tree</field>
        <field name="model">dl.wood.peeling.type</field>
        <field name="arch" type="xml">
            <list string="Loại Ván Bóc">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="species_id"/>
                <field name="name_en" optional="show"/>
                <field name="name_sci" optional="show"/>
                <field name="note" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_dl_wood_peeling_type_form" model="ir.ui.view">
        <field name="name">dl.wood.peeling.type.form</field>
        <field name="model">dl.wood.peeling.type</field>
        <field name="arch" type="xml">
            <form string="Loại Ván Bóc">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Ván bóc Keo"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="species_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="name_en"/>
                            <field name="name_sci"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Biến thể Ván Bóc" name="variants">
                            <field name="variant_ids">
                                <list editable="bottom">
                                    <field name="name" readonly="1" force_save="1"/>
                                    <field name="thickness"/>
                                    <field name="length"/>
                                    <field name="width"/>
                                    <field name="active" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                        <page string="Ghi chú" name="note">
                            <field name="note" nolabel="1" placeholder="Ghi chú thêm..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dl_wood_peeling_type" model="ir.actions.act_window">
        <field name="name">Loại Ván Bóc</field>
        <field name="res_model">dl.wood.peeling.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo Loại Ván Bóc mới
            </p>
            <p>
                Quản lý danh mục các Loại Ván Bóc (Ván bóc Keo, Ván bóc Thông...) liên kết với từng Loài gỗ.
            </p>
        </field>
    </record>

</odoo>
