<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_form_view_wood_inherit" model="ir.ui.view">
        <field name="name">mrp.production.form.wood.inherit</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <!-- Đưa trường Lô thành phẩm ra header dưới trường Sản phẩm -->
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="lot_producing_ids" 
                       widget="many2many_tags"
                       context="{'default_product_id': product_id, 'default_company_id': company_id}"
                       invisible="state == 'draft' or product_tracking in ['none', False]"
                       required="product_tracking != 'none' and state not in ['draft', 'cancel']"
                       placeholder="Nhập hoặc tạo Mã Lô thành phẩm..."/>
            </xpath>
        </field>
    </record>
</odoo>
