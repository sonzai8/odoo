<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================== -->
    <!-- DANH MỤC VÁN BÓC (dl.wood.peeling.type)        -->
    <!-- ============================================== -->
    <record id="view_dl_wood_peeling_type_tree" model="ir.ui.view">
        <field name="name">dl.wood.peeling.type.tree</field>
        <field name="model">dl.wood.peeling.type</field>
        <field name="arch" type="xml">
            <list string="Danh mục ván bóc" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="name_en" optional="show"/>
                <field name="name_sci" optional="show"/>
                <field name="code"/>
                <field name="note"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_dl_wood_peeling_type" model="ir.actions.act_window">
        <field name="name">Danh mục Ván Bóc</field>
        <field name="res_model">dl.wood.peeling.type</field>
        <field name="view_mode">list</field>
    </record>

    <!-- ============================================== -->
    <!-- HỒ SƠ VÁN BÓC (dl.wood.peeling.dossier)        -->
    <!-- ============================================== -->
    <record id="view_dl_wood_peeling_dossier_tree" model="ir.ui.view">
        <field name="name">dl.wood.peeling.dossier.tree</field>
        <field name="model">dl.wood.peeling.dossier</field>
        <field name="arch" type="xml">
            <list string="Hồ sơ ván bóc" decoration-info="state == 'draft'" decoration-success="state == 'using'" decoration-muted="state == 'done'">
                <field name="name"/>
                <field name="x_dossier_name"/>
                <field name="partner_id"/>
                <field name="date_received"/>
                <field name="qty_initial" sum="Tổng ban đầu"/>
                <field name="qty_available" sum="Tổng tồn KD" decoration-success="qty_available &gt; 0" decoration-danger="qty_available == 0"/>
                <field name="state" widget="badge" 
                       decoration-info="state == 'draft'" 
                       decoration-success="state == 'using'" 
                       decoration-muted="state == 'done'"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_dl_wood_peeling_dossier_form" model="ir.ui.view">
        <field name="name">dl.wood.peeling.dossier.form</field>
        <field name="model">dl.wood.peeling.dossier</field>
        <field name="arch" type="xml">
            <form string="Hồ sơ ván bóc">
                <header>
                    <button name="action_confirm" string="Xác nhận sử dụng" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_done" string="Đóng hồ sơ (Hết)" type="object"
                            invisible="state != 'using'"/>
                    <button name="action_draft" string="Quay lại Dự thảo" type="object"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,using,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Thông tin chung">
                            <field name="x_dossier_name" placeholder="Ví dụ: Lô ván bóc tháng 5/2026..."/>
                            <field name="partner_id" 
                                   context="{'default_x_is_peeling_supplier': True, 'default_is_company': True}"
                                   readonly="state != 'draft'"/>
                            <field name="date_received" readonly="state != 'draft'"/>
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Tổng hợp khối lượng">
                            <field name="qty_initial" readonly="1"/>
                            <field name="qty_used" readonly="1"/>
                            <field name="qty_available" readonly="1" decoration-success="qty_available &gt; 0" decoration-danger="qty_available == 0"/>
                            <field name="x_total_cost" widget="monetary" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Chi tiết ván bóc">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="peeling_type_id" options="{'no_create': True}"/>
                                    <field name="qty_initial"/>
                                    <field name="price_unit"/>
                                    <field name="x_subtotal"/>
                                    <field name="qty_used" readonly="1"/>
                                    <field name="qty_available" readonly="1" decoration-success="qty_available &gt; 0" decoration-danger="qty_available == 0"/>
                                </list>
                            </field>
                            <group>
                                <field name="note" placeholder="Ghi chú thêm về lô hàng..."/>
                            </group>
                        </page>
                        <page string="Tài liệu PDF">
                            <div class="alert alert-info" role="alert">
                                💡 Bạn có thể kéo thả trực tiếp các file PDF vào các nhóm tương ứng bên dưới.
                            </div>
                            <group>
                                <group string="1. Hợp đồng mua bán">
                                    <field name="x_contract_attachment_ids" widget="many2many_binary" nolabel="1"/>
                                </group>
                                <group string="2. Bảng kê lâm sản">
                                    <field name="x_bkls_attachment_ids" widget="many2many_binary" nolabel="1"/>
                                </group>
                            </group>
                            <group>
                                <group string="3. Hóa đơn / Phiếu thu">
                                    <field name="x_invoice_attachment_ids" widget="many2many_binary" nolabel="1"/>
                                </group>
                                <group string="4. Chứng từ vận chuyển">
                                    <field name="x_transport_attachment_ids" widget="many2many_binary" nolabel="1"/>
                                </group>
                            </group>
                            <group>
                                <group string="5. Kiểm định chất lượng">
                                    <field name="x_quality_attachment_ids" widget="many2many_binary" nolabel="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_dl_wood_peeling_dossier" model="ir.actions.act_window">
        <field name="name">Hồ Sơ Ván Bóc</field>
        <field name="res_model">dl.wood.peeling.dossier</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ============================================== -->
    <!-- MENUS                                          -->
    <!-- ============================================== -->
    <!-- Menu Danh mục ván bóc -->
    <menuitem id="menu_dl_wood_peeling_type"
              name="Danh mục Ván bóc"
              parent="dl_wood_traceability.menu_dl_wood_input_materials"
              action="action_dl_wood_peeling_type"
              sequence="25"/>

    <!-- Menu Hồ sơ ván bóc -->
    <menuitem id="menu_dl_wood_peeling_dossier"
              name="Hồ sơ Ván bóc"
              parent="dl_wood_traceability.menu_dl_wood_input_materials"
              action="action_dl_wood_peeling_dossier"
              sequence="12"/>

</odoo>
