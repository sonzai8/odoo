<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_dl_wood" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.dl.wood</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Cấu hình chung" string="Cấu hình chung" name="dl_wood_traceability">
                    <div class="row gx-5">
                        <!-- Cột 1: Cấu hình mã và vận chuyển -->
                        <div class="col-lg-6 col-12">
                            <block title="Cấu hình sinh mã tự động" name="wood_sequence_config">
                                <setting id="wood_prefix_setting" string="Mã công ty" help="Sử dụng để sinh mã Hồ sơ (HS) và Lệnh sản xuất (SX)">
                                    <field name="x_wood_prefix" class="w-100"/>
                                    <div class="text-muted mt-2">
                                        <strong>Quy tắc sinh mã:</strong>
                                        <ul class="mt-1">
                                            <li><strong>Hồ sơ gỗ:</strong> [Mã công ty]_HS_xxxx (VD: <span class="text-primary">QTP_HS_0001</span>)</li>
                                            <li><strong>Lệnh sản xuất:</strong> [Mã công ty]_SX_MMYY_xxxx (VD: <span class="text-primary">QTP_SX_0526_0001</span>)</li>
                                            <li><strong>Đơn hàng:</strong> [Mã công ty]_DH_MMYY_xxxx (VD: <span class="text-primary">QTP_DH_0526_0001</span>)</li>
                                        </ul>
                                        <p class="small italic">(*) MMYY: Tháng năm hiện tại. xxxx: Số tự động tăng riêng cho từng công ty.</p>
                                    </div>
                                </setting>
                            </block>
                            <block title="Cấu hình Khai thác &amp; Vận chuyển" name="wood_exploitation_logistics_config">
                                <setting id="wood_exploitation_logistics_setting" string="Thời gian &amp; Năng lực mặc định" help="Cấu hình thời gian chuẩn bị và năng lực khai thác mặc định của công ty">
                                    <group>
                                        <field name="x_prep_days" class="w-100"/>
                                        <field name="x_exploitation_capacity" class="w-100"/>
                                    </group>
                                </setting>
                            </block>
                        </div>

                        <!-- Cột 2: Các đại diện -->
                        <div class="col-lg-6 col-12">
                            <block title="Đại diện Công ty (Phục vụ In Hợp đồng/Tài liệu)" name="wood_company_representative">
                                <setting id="wood_representative_setting" string="Thông tin đại diện" help="Người đại diện ký kết các hợp đồng hồ sơ nguồn gốc gỗ">
                                    <group>
                                        <field name="x_representative" placeholder="Ví dụ: Nguyễn Văn A" class="w-100"/>
                                        <field name="x_representative_position" placeholder="Ví dụ: Giám đốc" class="w-100"/>
                                    </group>
                                </setting>
                            </block>
                            <block title="Đại diện Kiểm kê (Phục vụ Phiếu Kiểm kê)" name="wood_inventory_inspector">
                                <setting id="wood_inventory_inspector_setting" string="Thông tin người kiểm kê" help="Người thực hiện kiểm kê thực tế tại xưởng (thủ kho, quản đốc...)">
                                    <group>
                                        <field name="x_inventory_inspector" placeholder="Ví dụ: Nguyễn Văn B" class="w-100"/>
                                        <field name="x_inventory_inspector_position" placeholder="Ví dụ: Quản đốc" class="w-100"/>
                                    </group>
                                </setting>
                            </block>
                        </div>
                    </div>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_dl_wood_config_settings" model="ir.actions.act_window">
        <field name="name">Cấu hình Chung</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module' : 'dl_wood_traceability'}</field>
    </record>

    <menuitem id="menu_dl_wood_settings"
              name="Cấu hình chung"
              parent="menu_dl_wood_config_root"
              action="action_dl_wood_config_settings"
              sequence="5"/>
</odoo>
