    <record id="view_dl_woodpro_config_form" model="ir.ui.view">
        <field name="name">dl.woodpro.config.form</field>
        <field name="model">dl.woodpro.config</field>
        <field name="arch" type="xml">
            <form string="Cấu hình kết nối WoodPro">
                <header>
                    <button name="action_login" string="Đăng nhập API" type="object" class="btn-secondary"/>
                    <button name="action_fetch_companies" string="Lấy danh sách công ty" type="object" class="btn-secondary"/>
                    <button name="action_sync_forest_owners" string="Đồng bộ Chủ rừng" type="object" class="btn-primary"/>
                    <button name="action_sync_products" string="Đồng bộ Sản phẩm Gỗ" type="object" class="btn-primary"/>
                    <button name="action_sync_minings" string="Đồng bộ Hồ sơ gỗ (Minings)" type="object" class="btn-primary"/>
                    <button name="action_sync_customers" string="Đồng bộ Khách hàng" type="object" class="btn-primary"/>
                    <button name="action_sync_orders" string="Đồng bộ Đơn hàng &amp; LSX" type="object" class="btn-primary"/>
