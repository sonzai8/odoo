                        </group>
                        <group string="Ánh xạ và Đồng bộ">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="x_woodpro_company_id"/>
                            <field name="last_sync_date" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Nhật ký Debug" name="debug_log">
