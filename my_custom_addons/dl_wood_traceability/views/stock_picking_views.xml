<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_wood_inherit" model="ir.ui.view">
        <field name="name">stock.picking.form.wood.inherit</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <!-- Thêm cột lot_ids (Many2many tags) vào tab Operations nếu chưa có hoặc muốn hiển thị rõ hơn -->
            <xpath expr="//field[@name='move_ids']/list/field[@name='product_id']" position="after">
                <field name="lot_ids" widget="many2many_tags" 
                       groups="stock.group_production_lot" 
                       optional="show"
                       invisible="not has_tracking or has_tracking == 'none'"
                       context="{'default_product_id': product_id, 'default_company_id': company_id}"/>
            </xpath>
            
            <!-- Thêm tab Chi tiết (Detailed Operations) để nhập lot_name trực tiếp -->
            <xpath expr="//notebook" position="inside">
                <page string="Chi tiết sản xuất (Lô)" name="detailed_operations_wood">
                    <field name="move_line_ids" context="{'default_picking_id': id, 'default_location_id': location_id, 'default_location_dest_id': location_dest_id, 'default_company_id': company_id}">
                        <list editable="bottom" decoration-muted="state == 'cancel'">
                            <field name="product_id" readonly="1"/>
                            <field name="lot_name" placeholder="Gõ Mã Lô mới tại đây..." 
                                   invisible="not tracking or tracking == 'none'"/>
                            <field name="lot_id" groups="stock.group_production_lot"
                                   context="{'default_product_id': product_id, 'default_company_id': company_id}"
                                   invisible="not tracking or tracking == 'none'"/>
                            <field name="quantity" string="Số lượng"/>
                            <field name="product_uom_id" groups="uom.group_uom"/>
                            <field name="state" column_invisible="True"/>
                            <field name="tracking" column_invisible="True"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
