<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Kế thừa để ẩn các tab kế toán và gỡ bỏ bắt buộc -->
    <record id="view_partner_form_hide_accounting" model="ir.ui.view">
        <field name="name">res.partner.form.hide.accounting</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form"/>
        <field name="arch" type="xml">
            <!-- Ẩn lại Tab Kế toán/Hóa đơn -->
            <xpath expr="//page[@name='accounting']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='accounting_disabled']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- QUAN TRỌNG: Vẫn giữ gỡ bỏ bắt buộc ngầm để có thể lưu được khi ẩn -->
            <xpath expr="//field[@name='property_account_receivable_id']" position="attributes">
                <attribute name="required">0</attribute>
            </xpath>
            <xpath expr="//field[@name='property_account_payable_id']" position="attributes">
                <attribute name="required">0</attribute>
            </xpath>
        </field>
    </record>

    <!-- Kế thừa để ẩn tab Bán hàng & Mua hàng -->
    <record id="view_partner_form_hide_sales_purchases" model="ir.ui.view">
        <field name="name">res.partner.form.hide.sales.purchases</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!-- Ẩn lại Tab Bán hàng & Mua hàng -->
            <xpath expr="//page[@name='sales_purchases']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Giữ các nhãn tiếng Việt cho địa chỉ -->
            <xpath expr="//field[@name='state_id']" position="attributes">
                <attribute name="placeholder">Tỉnh / Thành phố</attribute>
            </xpath>
            <xpath expr="//field[@name='child_ids']//form//field[@name='state_id']" position="attributes">
                <attribute name="placeholder">Tỉnh / Thành phố</attribute>
            </xpath>
            <xpath expr="//field[@name='city']" position="attributes">
                <attribute name="placeholder">Xã / Phường</attribute>
            </xpath>
            <xpath expr="//field[@name='child_ids']//form//field[@name='city']" position="attributes">
                <attribute name="placeholder">Xã / Phường</attribute>
            </xpath>
        </field>
    </record>

    <!-- Kế thừa để ẩn các thông tin thuế trên Sản phẩm -->
    <record id="product_template_form_view_hide_taxes" model="ir.ui.view">
        <field name="name">product.template.form.hide.taxes</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="account.product_template_form_view"/>
        <field name="arch" type="xml">
            <!-- Ẩn Tab Kế toán trên sản phẩm -->
            <xpath expr="//page[@name='invoicing']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- Ẩn Thuế khách hàng -->
            <xpath expr="//label[@for='taxes_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[@name='taxes_div']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- Ẩn Thuế nhà cung cấp -->
            <xpath expr="//field[@name='supplier_taxes_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
