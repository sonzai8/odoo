<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_wood_inherit" model="ir.ui.view">
        <field name="name">product.template.form.wood.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <!-- Thêm header button cho Tạo Lệnh Sản Xuất -->
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_create_production_order" type="object" string="Tạo Lệnh Sản Xuất" class="btn-primary" invisible="not x_is_wood_product"/>
                </header>
            </xpath>

            <!-- Khoá các trường nếu đồng bộ từ MISA -->
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="readonly">x_is_misa_synced</attribute>
            </xpath>
            <xpath expr="//field[@name='default_code']" position="attributes">
                <attribute name="readonly">x_is_misa_synced</attribute>
            </xpath>
            <xpath expr="//field[@name='list_price']" position="attributes">
                <attribute name="readonly">x_is_misa_synced</attribute>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <field name="x_is_misa_synced" invisible="1"/>
            </xpath>

            <!-- Thêm smart button cho Lệnh sản xuất -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_production_orders" type="object" class="oe_stat_button" icon="fa-wrench" invisible="not x_is_wood_product">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value"><field name="x_production_order_count"/></span>
                        <span class="o_stat_text">Lệnh sản xuất</span>
                    </div>
                </button>
            </xpath>

            <!-- Làm readonly trường tracking nếu là sản phẩm gỗ -->
            <xpath expr="//field[@name='tracking']" position="attributes">
                <attribute name="readonly">x_is_wood_product</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>
            
            <!-- Chèn thêm khối Nguyên Liệu Yêu Cầu vào tab Gỗ do Base cung cấp -->
            <xpath expr="//div[@name='wood_dimensions']" position="after">
                <div class="dl_card mb-3 p-3 border rounded bg-white">
                    <h5 class="fw-bold mb-3 text-dark border-bottom pb-2">Nguyên liệu yêu cầu (Sản xuất)</h5>
                    <field name="x_required_species_ids" invisible="1"/>
                    <style>
                        .my_inline_m2m > div[aria-atomic="true"] {
                            display: grid !important;
                            grid-template-columns: repeat(4, 1fr) !important;
                            gap: 15px !important;
                        }
                    </style>
                    <field name="x_required_peeling_type_ids" widget="many2many_checkboxes" nolabel="1" class="my_inline_m2m w-100"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_product_template_tree_wood_inherit" model="ir.ui.view">
        <field name="name">product.template.tree.wood.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="attributes">
                <attribute name="optional">show</attribute>
                <attribute name="groups"></attribute>
            </xpath>
        </field>
    </record>

    <record id="action_dl_wood_product_template" model="ir.actions.act_window">
        <field name="name">Sản phẩm Gỗ</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('x_is_wood_product', '=', True)]</field>
        <field name="context">{'default_x_is_wood_product': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo sản phẩm gỗ đầu tiên của bạn.
            </p>
        </field>
    </record>
</odoo>
