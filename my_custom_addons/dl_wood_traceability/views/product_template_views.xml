<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_wood_inherit" model="ir.ui.view">
        <field name="name">product.template.form.wood.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <!-- Chèn checkbox is_wood_product dưới tên sản phẩm -->
            <xpath expr="//div[@name='options']" position="inside">
                <span class="d-inline-block">
                    <field name="is_wood_product"/>
                    <label for="is_wood_product"/>
                </span>
            </xpath>

            <!-- Làm readonly trường tracking nếu là sản phẩm gỗ -->
            <xpath expr="//field[@name='tracking']" position="attributes">
                <attribute name="readonly">is_wood_product</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="action_dl_wood_product_template" model="ir.actions.act_window">
        <field name="name">Sản phẩm Gỗ</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('is_wood_product', '=', True)]</field>
        <field name="context">{'default_is_wood_product': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo sản phẩm gỗ đầu tiên của bạn.
            </p>
        </field>
    </record>

    <menuitem id="menu_dl_wood_product" 
              name="Sản phẩm Gỗ" 
              parent="menu_dl_wood_traceability_root" 
              action="action_dl_wood_product_template" 
              sequence="15"/>
</odoo>
