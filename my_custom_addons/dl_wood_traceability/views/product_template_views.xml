<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_wood_inherit" model="ir.ui.view">
        <field name="name">product.template.form.wood.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <!-- Chèn checkbox is_wood_product dưới tên sản phẩm -->
            <xpath expr="//div[@name='options']" position="inside">
                <span class="d-inline-block">
                    <field name="is_wood_product"/>
                    <label for="is_wood_product"/>
                </span>
            </xpath>

            <!-- Thêm header button cho Tạo Lệnh Sản Xuất -->
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_create_production_order" type="object" string="Tạo Lệnh Sản Xuất" class="btn-primary" invisible="not is_wood_product"/>
                </header>
            </xpath>

            <!-- Thêm smart button cho Lệnh sản xuất -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_production_orders" type="object" class="oe_stat_button" icon="fa-wrench" invisible="not is_wood_product">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value"><field name="x_production_order_count"/></span>
                        <span class="o_stat_text">Lệnh sản xuất</span>
                    </div>
                </button>
            </xpath>

            <!-- Làm readonly trường tracking nếu là sản phẩm gỗ -->
            <xpath expr="//field[@name='tracking']" position="attributes">
                <attribute name="readonly">is_wood_product</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="action_dl_wood_product_template" model="ir.actions.act_window">
        <field name="name">Sản phẩm Gỗ</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('is_wood_product', '=', True)]</field>
        <field name="context">{'default_is_wood_product': True, 'default_x_is_wood_product': True, 'x_hide_payroll_options': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo sản phẩm gỗ đầu tiên của bạn.
            </p>
        </field>
    </record>

    <menuitem id="menu_dl_wood_product" 
              name="Sản phẩm Gỗ" 
              parent="menu_dl_wood_production" 
              action="action_dl_wood_product_template" 
              sequence="55"/>
</odoo>
