<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================= -->
    <!-- KHÁCH HÀNG (res.partner)  -->
    <!-- ========================= -->
    <record id="view_dl_wood_customer_list" model="ir.ui.view">
        <field name="name">dl.wood.customer.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Khách hàng mua gỗ">
                <field name="name"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="street"/>
                <field name="city"/>
                <field name="state_id"/>
                <field name="x_customer_code"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_dl_wood_customer" model="ir.actions.act_window">
        <field name="name">Khách hàng</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('x_is_wood_customer', '=', True)]</field>
        <field name="context">{'default_x_is_wood_customer': True}</field>
        <field name="view_id" ref="view_dl_wood_customer_list"/>
    </record>

    <!-- ============================= -->
    <!-- ĐƠN ĐẶT HÀNG (dl.wood.sale.order) -->
    <!-- ============================= -->
    <record id="view_dl_wood_sale_order_form" model="ir.ui.view">
        <field name="name">dl.wood.sale.order.form</field>
        <field name="model">dl.wood.sale.order</field>
        <field name="arch" type="xml">
            <form string="Đơn đặt hàng gỗ">
                <header>
                    <button name="action_confirm" string="Xác nhận" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_done" string="Hoàn thành" type="object"
                            class="oe_highlight" invisible="state != 'confirmed'"/>
                    <button name="action_cancel" string="Hủy" type="object"
                            invisible="state in ('done', 'cancelled')"/>
                    <button name="action_draft" string="Đặt lại" type="object"
                            invisible="state not in ('cancelled',)"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_productions" type="object"
                                class="oe_stat_button" icon="fa-cogs"
                                invisible="production_count == 0">
                            <field name="production_count" widget="statinfo" string="Lệnh SX"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Thông tin đơn hàng">
                            <field name="partner_id"/>
                            <field name="date_order"/>
                            <field name="company_id" readonly="1"/>
                        </group>
                        <group string="Ghi chú">
                            <field name="note" nolabel="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lệnh sản xuất">
                            <field name="production_order_ids" context="{'default_sale_order_id': id}">
                                <list string="Lệnh sản xuất" editable="bottom">
                                    <field name="x_select_production_id" readonly="id != False"/>
                                    <field name="name" readonly="1"/>
                                    <field name="product_id" readonly="x_select_production_id != False"/>
                                    <field name="qty_planned" readonly="x_select_production_id != False"/>
                                    <field name="qty_done" readonly="x_select_production_id != False"/>
                                    <field name="uom_id" optional="hide"/>
                                    <field name="date_planned" readonly="x_select_production_id != False"/>
                                    <field name="total_volume_actual" optional="show"/>
                                    <field name="state" widget="badge"
                                           decoration-info="state == 'draft'"
                                           decoration-warning="state == 'in_progress'"
                                           decoration-success="state == 'done'"
                                           decoration-danger="state == 'cancelled'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dl_wood_sale_order_list" model="ir.ui.view">
        <field name="name">dl.wood.sale.order.list</field>
        <field name="model">dl.wood.sale.order</field>
        <field name="arch" type="xml">
            <list string="Đơn đặt hàng gỗ"
                  decoration-muted="state == 'cancelled'"
                  decoration-info="state == 'confirmed'"
                  decoration-success="state == 'done'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date_order"/>
                <field name="production_count" string="Lệnh SX"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_dl_wood_sale_order_search" model="ir.ui.view">
        <field name="name">dl.wood.sale.order.search</field>
        <field name="model">dl.wood.sale.order</field>
        <field name="arch" type="xml">
            <search string="Tìm đơn đặt hàng">
                <field name="name"/>
                <field name="partner_id"/>
                <separator/>
                <filter string="Dự thảo" name="filter_draft" domain="[('state','=','draft')]"/>
                <filter string="Đã xác nhận" name="filter_confirmed" domain="[('state','=','confirmed')]"/>
                <filter string="Hoàn thành" name="filter_done" domain="[('state','=','done')]"/>
                <separator/>
                <filter string="Theo Khách hàng" name="group_by_partner" context="{'group_by':'partner_id'}"/>
                <filter string="Theo Công ty" name="group_by_company" context="{'group_by':'company_id'}" groups="base.group_multi_company"/>
            </search>
        </field>
    </record>

    <record id="action_dl_wood_sale_order" model="ir.actions.act_window">
        <field name="name">Đơn đặt hàng</field>
        <field name="res_model">dl.wood.sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_dl_wood_sale_order_search"/>
    </record>

    <!-- ===================================== -->
    <!-- LỆNH SẢN XUẤT (dl.wood.production.order) -->
    <!-- ===================================== -->
    <record id="view_dl_wood_production_order_form" model="ir.ui.view">
        <field name="name">dl.wood.production.order.form</field>
        <field name="model">dl.wood.production.order</field>
        <field name="arch" type="xml">
            <form string="Lệnh sản xuất gỗ">
                <header>
                    <button name="action_start" string="Bắt đầu SX" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_done" string="Hoàn thành" type="object"
                            class="oe_highlight" invisible="state != 'in_progress'"/>
                    <button name="action_previous_state" string="Quay lại trạng thái trước" type="object"
                            invisible="state not in ('in_progress', 'done')"/>
                    <button name="action_cancel" string="Hủy" type="object"
                            invisible="state in ('done', 'cancelled')"/>
                    <button name="action_draft" string="Đặt lại" type="object"
                            invisible="state not in ('cancelled',)"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,in_progress,done"/>
                </header>
                <sheet>
                    <field name="x_select_production_id" invisible="True"/>
                    <div class="alert alert-info text-center" role="alert" invisible="not x_select_production_id" style="margin-bottom:15px; font-weight:bold;">
                        ℹ️ Lệnh sản xuất này được liên kết từ lệnh có sẵn. Các thông số sản xuất đã được khóa (chỉ cho xem).
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Thông tin sản xuất">
                            <field name="sale_order_id" readonly="state in ('done', 'cancelled') or x_select_production_id != False"/>
                            <field name="x_select_production_id" readonly="1" invisible="not x_select_production_id"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="product_id" readonly="state in ('done', 'cancelled') or x_select_production_id != False"/>
                            <field name="uom_id" readonly="1"/>
                            <field name="company_id" readonly="1"/>
                        </group>
                        <group string="Số lượng &amp; Thời gian">
                            <field name="qty_planned" readonly="state in ('done', 'cancelled') or x_select_production_id != False"/>
                            <field name="qty_done" readonly="state in ('done', 'cancelled') or x_select_production_id != False"/>
                            <field name="x_co_yield" readonly="state in ('done', 'cancelled') or x_select_production_id != False"/>
                            <field name="date_planned" readonly="state in ('done', 'cancelled') or x_select_production_id != False"/>
                            <field name="date_done" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Tiêu hao Nguyên vật liệu">
                            <field name="line_ids" readonly="state in ('done', 'cancelled')">
                                <list string="NVL tiêu hao" editable="bottom">
                                    <field name="dossier_id"
                                           domain="[('company_id', '=', parent.company_id), ('state', '!=', 'cancelled')]"/>
                                    <field name="x_available_species_ids" column_invisible="True"/>
                                    <field name="species_id"
                                           domain="[('id', 'in', x_available_species_ids)]"/>
                                    <field name="x_ratio"/>
                                    <field name="x_co_yield"/>
                                    <field name="volume_planned"/>
                                    <field name="volume_actual"/>
                                    <field name="note"/>
                                </list>
                            </field>
                            <group col="12" class="mt-2">
                                <group colspan="6" string="Tổng cộng hiện tại">
                                    <field name="x_total_ratio" readonly="1"/>
                                    <field name="total_volume_planned" readonly="1"/>
                                    <field name="total_volume_actual" readonly="1"/>
                                </group>
                                <group colspan="6" string="Còn thiếu cho sản xuất">
                                    <field name="x_remaining_ratio" readonly="1" decoration-danger="x_remaining_ratio &gt; 0" decoration-success="x_remaining_ratio == 0"/>
                                    <field name="x_remaining_volume_planned" readonly="1" decoration-danger="x_remaining_volume_planned &gt; 0" decoration-success="x_remaining_volume_planned == 0"/>
                                    <field name="x_remaining_volume_actual" readonly="1" decoration-danger="x_remaining_volume_actual &gt; 0" decoration-success="x_remaining_volume_actual == 0"/>
                                </group>
                            </group>
                        </page>
                        <page string="Ghi chú">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dl_wood_production_order_list" model="ir.ui.view">
        <field name="name">dl.wood.production.order.list</field>
        <field name="model">dl.wood.production.order</field>
        <field name="arch" type="xml">
            <list string="Lệnh sản xuất"
                  decoration-muted="state == 'cancelled'"
                  decoration-warning="state == 'in_progress'"
                  decoration-success="state == 'done'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="sale_order_id"/>
                <field name="product_id"/>
                <field name="qty_planned"/>
                <field name="qty_done"/>
                <field name="total_volume_actual" string="KL NVL (m³)"/>
                <field name="date_planned"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_dl_wood_production_order_search" model="ir.ui.view">
        <field name="name">dl.wood.production.order.search</field>
        <field name="model">dl.wood.production.order</field>
        <field name="arch" type="xml">
            <search string="Tìm lệnh sản xuất">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="sale_order_id"/>
                <separator/>
                <filter string="Dự thảo" name="filter_draft" domain="[('state','=','draft')]"/>
                <filter string="Đang SX" name="filter_inprogress" domain="[('state','=','in_progress')]"/>
                <filter string="Hoàn thành" name="filter_done" domain="[('state','=','done')]"/>
                <separator/>
                <filter string="Theo Khách hàng" name="group_by_partner" context="{'group_by':'partner_id'}"/>
                <filter string="Theo Sản phẩm" name="group_by_product" context="{'group_by':'product_id'}"/>
                <filter string="Theo Công ty" name="group_by_company" context="{'group_by':'company_id'}" groups="base.group_multi_company"/>
            </search>
        </field>
    </record>

    <record id="action_dl_wood_production_order" model="ir.actions.act_window">
        <field name="name">Lệnh sản xuất</field>
        <field name="res_model">dl.wood.production.order</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_dl_wood_production_order_search"/>
    </record>

    <!-- ========================= -->
    <!-- MENU CẤU TRÚC             -->
    <!-- ========================= -->
    <menuitem id="menu_dl_wood_production"
              name="Sản xuất"
              parent="menu_dl_wood_traceability_root"
              sequence="30"/>

    <menuitem id="menu_dl_wood_customer"
              name="Khách hàng"
              parent="menu_dl_wood_production"
              action="action_dl_wood_customer"
              sequence="10"/>

    <menuitem id="menu_dl_wood_sale_order"
              name="Đơn đặt hàng"
              parent="menu_dl_wood_production"
              action="action_dl_wood_sale_order"
              sequence="20"/>

    <menuitem id="menu_dl_wood_production_order"
              name="Lệnh sản xuất"
              parent="menu_dl_wood_production"
              action="action_dl_wood_production_order"
              sequence="30"/>

</odoo>
