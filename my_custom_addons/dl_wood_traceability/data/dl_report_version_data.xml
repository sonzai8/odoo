        <record id="template_v2025_bbxm" model="dl.wood.report.template.config">
            <field name="version_id" ref="report_version_v2025"/>
            <field name="sequence">50</field>
            <field name="name">5. Biên bản xác minh</field>
            <field name="template_key">bbxm</field>
            <field name="category">exploitation</field>
        </record>
