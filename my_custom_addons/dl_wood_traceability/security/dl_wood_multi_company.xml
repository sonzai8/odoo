<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- 
            Record Rules for Multi-company support 
            Dữ liệu độc lập hoàn toàn giữa các công ty. 
            Xóa bỏ phần ('company_id', '=', False) để không cho phép bản ghi dùng chung.
        -->
        
        <record id="dl_wood_species_comp_rule" model="ir.rule">
            <field name="name">Loại gỗ đa công ty (Strict)</field>
            <field name="model_id" ref="model_dl_wood_species"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="dl_wood_species_grade_comp_rule" model="ir.rule">
            <field name="name">Phân loại gỗ đa công ty (Strict)</field>
            <field name="model_id" ref="model_dl_wood_species_grade"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="dl_wood_dossier_comp_rule" model="ir.rule">
            <field name="name">Hồ sơ gỗ đa công ty (Strict)</field>
            <field name="model_id" ref="model_dl_wood_dossier"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="dl_wood_exploitation_location_comp_rule" model="ir.rule">
            <field name="name">Địa điểm khai thác đa công ty (Strict)</field>
            <field name="model_id" ref="model_dl_wood_exploitation_location"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="dl_wood_contract_template_comp_rule" model="ir.rule">
            <field name="name">Mẫu hợp đồng đa công ty (Strict)</field>
            <field name="model_id" ref="model_dl_wood_contract_template"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="dl_woodpro_config_comp_rule" model="ir.rule">
            <field name="name">Cấu hình WoodPro đa công ty (Strict)</field>
            <field name="model_id" ref="model_dl_woodpro_config"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="dl_dossier_ledger_comp_rule" model="ir.rule">
            <field name="name">Sổ cái đa công ty (Strict)</field>
            <field name="model_id" ref="model_dl_dossier_ledger"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="dl_wood_sale_order_comp_rule" model="ir.rule">
            <field name="name">Đơn hàng gỗ đa công ty (Strict)</field>
            <field name="model_id" ref="model_dl_wood_sale_order"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="dl_wood_production_order_comp_rule" model="ir.rule">
            <field name="name">Lệnh sản xuất đa công ty (Strict)</field>
            <field name="model_id" ref="model_dl_wood_production_order"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="dl_co_declaration_comp_rule" model="ir.rule">
            <field name="name">Khai báo CO đa công ty (Strict)</field>
            <field name="model_id" ref="model_dl_co_declaration"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="dl_wood_log_comp_rule" model="ir.rule">
            <field name="name">Log đa công ty (Strict)</field>
            <field name="model_id" ref="model_dl_wood_log"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="dl_wood_log_config_comp_rule" model="ir.rule">
            <field name="name">Cấu hình log đa công ty (Strict)</field>
            <field name="model_id" ref="model_dl_wood_log_config"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="dl_woodpro_external_company_comp_rule" model="ir.rule">
            <field name="name">Danh sách công ty WoodPro đa công ty (Strict)</field>
            <field name="model_id" ref="model_dl_woodpro_external_company"/>
            <field name="domain_force">[('config_id.company_id', 'in', company_ids)]</field>
        </record>

        <record id="dl_wood_dossier_line_comp_rule" model="ir.rule">
            <field name="name">Chi tiết hồ sơ gỗ đa công ty (Strict)</field>
            <field name="model_id" ref="model_dl_wood_dossier_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="dl_wood_dossier_document_comp_rule" model="ir.rule">
            <field name="name">Tài liệu hồ sơ gỗ đa công ty (Strict)</field>
            <field name="model_id" ref="model_dl_wood_dossier_document"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="dl_wood_dossier_attachment_comp_rule" model="ir.rule">
            <field name="name">Đính kèm hồ sơ gỗ đa công ty (Strict)</field>
            <field name="model_id" ref="model_dl_wood_dossier_attachment"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="dl_wood_vehicle_comp_rule" model="ir.rule">
            <field name="name">Xe vận chuyển đa công ty</field>
            <field name="model_id" ref="model_dl_wood_vehicle"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="dl_wood_dossier_transport_comp_rule" model="ir.rule">
            <field name="name">Cấu hình vận chuyển đa công ty</field>
            <field name="model_id" ref="model_dl_wood_dossier_transport"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="dl_wood_dossier_transport_ticket_comp_rule" model="ir.rule">
            <field name="name">Phiếu vận chuyển đa công ty</field>
            <field name="model_id" ref="model_dl_wood_dossier_transport_ticket"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="dl_wood_dossier_transport_ticket_line_comp_rule" model="ir.rule">
            <field name="name">Chi tiết phiếu vận chuyển đa công ty</field>
            <field name="model_id" ref="model_dl_wood_dossier_transport_ticket_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="dl_wood_production_line_comp_rule" model="ir.rule">
            <field name="name">Chi tiết tiêu hao đa công ty (Strict)</field>
            <field name="model_id" ref="model_dl_wood_production_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="dl_wood_dossier_inventory_comp_rule" model="ir.rule">
            <field name="name">Kiểm kê hồ sơ gỗ đa công ty (Strict)</field>
            <field name="model_id" ref="model_dl_wood_dossier_inventory"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="dl_wood_dossier_inventory_line_comp_rule" model="ir.rule">
            <field name="name">Chi tiết kiểm kê đa công ty (Strict)</field>
            <field name="model_id" ref="model_dl_wood_dossier_inventory_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="dl_wood_partner_comp_rule" model="ir.rule">
            <field name="name">Đối tác gỗ đa công ty (Strict)</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="domain_force">['|', '&amp;', ('x_is_wood_supplier', '=', False), ('x_is_wood_customer', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="dl_wood_product_template_comp_rule" model="ir.rule">
            <field name="name">Sản phẩm gỗ đa công ty (Strict)</field>
            <field name="model_id" ref="product.model_product_template"/>
            <field name="domain_force">['|', ('is_wood_product', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="dl_vietnam_bank_comp_rule" model="ir.rule">
            <field name="name">Ngân hàng Việt Nam đa công ty (Flexible)</field>
            <field name="model_id" ref="model_dl_vietnam_bank"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="dl_wood_report_version_comp_rule" model="ir.rule">
            <field name="name">Phiên bản biểu mẫu đa công ty (Strict)</field>
            <field name="model_id" ref="model_dl_wood_report_version"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="dl_wood_peeling_dossier_comp_rule" model="ir.rule">
            <field name="name">Hồ sơ ván bóc đa công ty (Strict)</field>
            <field name="model_id" ref="model_dl_wood_peeling_dossier"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="dl_wood_peeling_invoice_comp_rule" model="ir.rule">
            <field name="name">Hoá đơn ván bóc đa công ty (Strict)</field>
            <field name="model_id" ref="model_dl_wood_peeling_invoice"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="dl_wood_peeling_production_line_comp_rule" model="ir.rule">
            <field name="name">Chi tiết tiêu hao ván bóc đa công ty (Strict)</field>
            <field name="model_id" ref="model_dl_wood_peeling_production_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
