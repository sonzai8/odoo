<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dl_wood_init_data_wizard_form" model="ir.ui.view">
        <field name="name">dl.wood.init.data.wizard.form</field>
        <field name="model">dl.wood.init.data.wizard</field>
        <field name="arch" type="xml">
            <form string="Khởi Tạo Dữ Liệu">
                <p class="oe_grey">
                    Nhấn vào các nút bên dưới để khởi tạo dữ liệu mẫu (các loài gỗ hoặc danh sách ngân hàng Việt Nam) cho công ty hiện tại. 
                    Hệ thống sẽ chỉ tạo mới những dữ liệu chưa tồn tại.
                </p>
                <footer>
                    <button name="action_init_wood_species" string="Khởi Tạo Danh Mục Gỗ" type="object" class="btn-primary" icon="fa-database"/>
                    <button name="action_init_peeling_types" string="Khởi Tạo Danh Mục Ván Bóc" type="object" class="btn-warning" icon="fa-layer-group"/>
                    <button name="action_init_vietnam_banks" string="Khởi Tạo Danh Mục Ngân Hàng" type="object" class="btn-info" icon="fa-university"/>
                    <button name="action_init_report_templates" string="Khởi Tạo Biểu Mẫu" type="object" class="btn-success" icon="fa-file-text-o"/>
                    <button name="action_init_vehicles" string="Khởi Tạo Xe Vận Chuyển" type="object" class="btn-warning" icon="fa-truck"/>
                    <button name="action_init_state_sequence" string="Sắp Xếp Lại Tỉnh/Thành" type="object" class="btn-dark" icon="fa-sort-numeric-asc"/>
                    <button name="action_init_vietnam_wards" string="Khởi Tạo Danh Mục Xã/Phường" type="object" class="btn-danger" icon="fa-map-marker"/>
                    <button string="Đóng" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_dl_wood_init_data_wizard" model="ir.actions.act_window">
        <field name="name">Khởi Tạo Dữ Liệu</field>
        <field name="res_model">dl.wood.init.data.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
