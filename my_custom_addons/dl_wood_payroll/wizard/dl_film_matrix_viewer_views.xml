<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dl_film_matrix_viewer_form" model="ir.ui.view">
        <field name="name">dl.film.matrix.viewer.form</field>
        <field name="model">dl.film.matrix.viewer</field>
        <field name="arch" type="xml">
            <form string="Ma trận Đơn giá Ép Film">
                <sheet>
                    <field name="html_content" widget="html" nolabel="1" readonly="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dl_film_matrix_viewer" model="ir.actions.act_window">
        <field name="name">Ma trận Đơn giá Ép Film</field>
        <field name="res_model">dl.film.matrix.viewer</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>
</odoo>
