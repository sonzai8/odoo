<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dl_global_payroll_wizard_form" model="ir.ui.view">
        <field name="name">dl.global.payroll.wizard.form</field>
        <field name="model">dl.global.payroll.wizard</field>
        <field name="arch" type="xml">
            <form string="Xuất báo cáo lương tổng hợp">
                <group>
                    <group>
                        <field name="month"/>
                        <field name="year"/>
                    </group>
                </group>
                <footer>
                    <button name="action_export_excel" string="Xuất Excel" type="object" class="btn-primary"/>
                    <button string="Hủy" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_dl_global_payroll_wizard" model="ir.actions.act_window">
        <field name="name">Báo cáo lương tổng hợp</field>
        <field name="res_model">dl.global.payroll.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
