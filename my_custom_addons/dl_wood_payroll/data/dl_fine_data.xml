<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Default Fine Reasons -->
        <record id="fine_reason_late" model="dl.fine.reason">
            <field name="name">Đi muộn</field>
            <field name="default_amount">50000</field>
            <field name="sequence">10</field>
        </record>

        <record id="fine_reason_wrong_output" model="dl.fine.reason">
            <field name="name">Báo sai sản lượng</field>
            <field name="default_amount">500000</field>
            <field name="sequence">20</field>
        </record>

        <record id="fine_reason_no_permission" model="dl.fine.reason">
            <field name="name">Nghỉ không phép</field>
            <field name="default_amount">500000</field>
            <field name="sequence">30</field>
        </record>

        <!-- Sequence for Fine Tickets -->
        <record id="seq_dl_employee_fine" model="ir.sequence">
            <field name="name">Fine Ticket Sequence</field>
            <field name="code">dl.employee.fine</field>
            <field name="prefix">PHAT/%(range_year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
