<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Stevedore Service View -->
    <record id="view_dl_stevedore_service_tree" model="ir.ui.view">
        <field name="name">dl.stevedore.service.tree</field>
        <field name="model">dl.stevedore.service</field>
        <field name="arch" type="xml">
            <list string="Danh mục công việc" editable="bottom">
                <field name="name"/>
                <field name="default_unit_price"/>
                <field name="uom_id"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_dl_stevedore_service" model="ir.actions.act_window">
        <field name="name">Danh mục công việc</field>
        <field name="res_model">dl.stevedore.service</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Stevedore Log List View -->
    <record id="view_dl_stevedore_log_tree" model="ir.ui.view">
        <field name="name">dl.stevedore.log.tree</field>
        <field name="model">dl.stevedore.log</field>
        <field name="arch" type="xml">
            <list string="Lương khoán Bốc vác" decoration-info="state == 'draft'" decoration-success="state == 'confirmed'">
                <field name="date"/>
                <field name="name"/>
                <field name="service_name"/>
                <field name="total_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'confirmed'"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- Stevedore Log Form View -->
    <record id="view_dl_stevedore_log_form" model="ir.ui.view">
        <field name="name">dl.stevedore.log.form</field>
        <field name="model">dl.stevedore.log</field>
        <field name="arch" type="xml">
            <form string="Phiếu khoán Bốc vác">
                <header>
                    <button name="action_divide_equally" string="Reset &amp; Chia đều" type="object" class="btn-secondary" invisible="state != 'draft'" groups="dl_wood_payroll.group_dl_payroll_manager"/>
                    <button name="action_confirm" string="Xác nhận" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_draft" string="Mở lại dự thảo" type="object" class="btn-secondary" invisible="state != 'confirmed'" groups="dl_wood_payroll.group_dl_payroll_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Mã phiếu"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Nội dung công việc">
                            <field name="service_id" options="{'no_create': True}" readonly="state != 'draft'"/>
                            <field name="manual_service_name" readonly="state != 'draft'" placeholder="Nhập tay nếu không có trong danh mục..."/>
                            <field name="date" readonly="state != 'draft'"/>
                        </group>
                        <group string="Tính toán tiền khoán">
                            <label for="unit_price" string="Đơn giá &amp; Số lượng"/>
                            <div class="o_row">
                                <field name="unit_price" readonly="state != 'draft'"/> x 
                                <field name="quantity" readonly="state != 'draft'"/>
                            </div>
                            <field name="total_amount" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Danh sách nhân viên thụ hưởng" name="workers">
                            <div class="alert alert-info" role="alert" invisible="state != 'draft'">
                                💡 Hệ thống tự động chia tiền theo <b>hệ số công</b>. Bạn có thể <b>nhập trực tiếp số tiền</b> để ghi đè (override) dòng đó.
                            </div>
                            <field name="worker_line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="employee_id" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="attendance_value"/>
                                    <field name="amount" sum="Tổng tiền chia" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="is_manual_amount" widget="boolean_toggle" optional="hide"/>
                                    <field name="note" placeholder="Ghi chú..."/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <label for="total_amount" string="Tổng tiền khoán: "/>    
                                <div class="o_row">
                                    <field name="total_amount" widget="monetary" class="oe_subtotal_footer_separator"/>
                                </div>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_stevedore_log_search" model="ir.ui.view">
        <field name="name">stevedore.log.search</field>
        <field name="model">dl.stevedore.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="service_name"/>
                <field name="service_id"/>
                <filter string="Dự thảo" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Đã xác nhận" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
            </search>
        </field>
    </record>

    <!-- Stevedore Log Action -->
    <record id="action_dl_stevedore_log" model="ir.actions.act_window">
        <field name="name">Lương khoán Bốc vác</field>
        <field name="res_model">dl.stevedore.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_stevedore_log_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Bắt đầu ghi nhận vụ việc bốc vác hoặc khoán việc mới.
            </p>
            <p>
                Chi phí bốc vác sẽ được tổng hợp vào báo cáo Ma trận Lương ngày.
            </p>
        </field>
    </record>
    <!-- Stevedore Log Line Pivot View (Matrix) -->
    <record id="view_dl_stevedore_log_line_pivot" model="ir.ui.view">
        <field name="name">dl.stevedore.log.line.pivot</field>
        <field name="model">dl.stevedore.log.line</field>
        <field name="arch" type="xml">
            <pivot string="Ma trận Lương bốc vác" sample="1">
                <field name="employee_id" type="row"/>
                <field name="date" interval="day" type="col"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_dl_stevedore_matrix" model="ir.actions.act_window">
        <field name="name">Ma trận Lương bốc vác</field>
        <field name="res_model">dl.stevedore.log.line</field>
        <field name="view_mode">pivot,list</field>
    </record>

</odoo>
