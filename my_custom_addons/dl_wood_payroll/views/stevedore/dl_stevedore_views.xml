<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Stevedore Task Views -->
    <record id="view_dl_stevedore_task_tree" model="ir.ui.view">
        <field name="name">dl.stevedore.task.tree</field>
        <field name="model">dl.stevedore.task</field>
        <field name="arch" type="xml">
            <list string="Danh mục công việc" editable="bottom">
                <field name="name"/>
                <field name="uom_id"/>
                <field name="unit_price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="note"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="action_dl_stevedore_task" model="ir.actions.act_window">
        <field name="name">Cấu hình Công việc</field>
        <field name="res_model">dl.stevedore.task</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Stevedore Log Views -->
    <record id="view_dl_stevedore_log_tree" model="ir.ui.view">
        <field name="name">dl.stevedore.log.tree</field>
        <field name="model">dl.stevedore.log</field>
        <field name="arch" type="xml">
            <list string="Nhật ký Bốc vác" decoration-info="state == 'draft'" decoration-success="state == 'confirmed'">
                <field name="date"/>
                <field name="task_id" options="{'no_create': True}"/>
                <field name="production_group_id" optional="show"/>
                <field name="quantity"/>
                <field name="worker_ids" widget="many2many_tags" options="{'no_create': True}"/>
                <field name="amount_per_worker" widget="monetary"/>
                <field name="total_amount" widget="monetary" sum="Tổng tiền"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'confirmed'"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_dl_stevedore_log_form" model="ir.ui.view">
        <field name="name">dl.stevedore.log.form</field>
        <field name="model">dl.stevedore.log</field>
        <field name="arch" type="xml">
            <form string="Phiếu Bốc Vác">
                <header>
                    <button name="action_confirm" string="Xác nhận" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_draft" string="Mở lại Nháp" type="object" invisible="state != 'confirmed'" groups="dl_wood_payroll.group_dl_wood_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Mã phiếu"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Thông tin chung">
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="task_id" options="{'no_create': True}" readonly="state != 'draft'"/>
                            <field name="production_group_id" options="{'no_create': True}" readonly="state != 'draft'"/>
                        </group>
                        <group string="Khối lượng &amp; Thành tiền">
                            <field name="quantity" string="Sản lượng thực tế" readonly="state != 'draft'"/>
                            <field name="unit_price" widget="monetary"/>
                            <field name="total_amount" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Phân chia tiền lương">
                        <field name="worker_ids" widget="many2many_tags" options="{'no_create': True}" readonly="state != 'draft'" placeholder="Chọn nhanh nhân viên..."/>
                        <field name="amount_per_worker" widget="monetary" string="Đơn giá/Công (dự kiến)"/>
                        <field name="line_ids" nolabel="1" colspan="2" readonly="state != 'draft'">
                            <list editable="bottom">
                                <field name="employee_id" options="{'no_create': True}"/>
                                <field name="x_source_group_id" readonly="1"/>
                                <field name="quantity" sum="Tổng công" widget="float" options="{'step': 0.1}"/>
                                <field name="amount" widget="monetary" sum="Tổng tiền"/>
                                <field name="currency_id" column_invisible="True"/>
                            </list>
                        </field>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_dl_stevedore_log_kanban" model="ir.ui.view">
        <field name="name">dl.stevedore.log.kanban</field>
        <field name="model">dl.stevedore.log</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <field name="name"/>
                <field name="date"/>
                <field name="task_id"/>
                <field name="total_amount"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record_top">
                            <strong class="o_kanban_record_title"><field name="name"/></strong>
                            <span class="float-end badge rounded-pill"><field name="state"/></span>
                        </div>
                        <div class="o_kanban_record_body">
                            <div><field name="task_id"/></div>
                            <div>Ngày: <field name="date"/></div>
                            <div>Tổng tiền: <field name="total_amount" widget="monetary"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_dl_stevedore_log_search" model="ir.ui.view">
        <field name="name">dl.stevedore.log.search</field>
        <field name="model">dl.stevedore.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="task_id"/>
                <field name="production_group_id"/>
                <filter string="Dự thảo" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Đã xác nhận" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <searchpanel>
                    <field name="production_group_id" string="Tổ sản xuất" icon="fa-users" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="action_dl_stevedore_log" model="ir.actions.act_window">
        <field name="name">Nhật ký Bốc vác</field>
        <field name="res_model">dl.stevedore.log</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_dl_stevedore_log_search"/>
    </record>

    <!-- Report Views on Stevedore Log Line -->
    <record id="view_dl_stevedore_log_line_pivot" model="ir.ui.view">
        <field name="name">dl.stevedore.log.line.pivot</field>
        <field name="model">dl.stevedore.log.line</field>
        <field name="arch" type="xml">
            <pivot string="Báo cáo Bốc vác">
                <field name="employee_id" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_dl_stevedore_report" model="ir.actions.act_window">
        <field name="name">Báo cáo Lương Bốc vác</field>
        <field name="res_model">dl.stevedore.log.line</field>
        <field name="view_mode">pivot,list</field>
    </record>

</odoo>
