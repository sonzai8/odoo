<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dl_production_group_tree" model="ir.ui.view">
        <field name="name">dl.production.group.tree</field>
        <field name="model">dl.production.group</field>
        <field name="arch" type="xml">
            <list string="Tổ sản xuất">
                <field name="name"/>
                <field name="x_workshop_id"/>
                <field name="department_id" string="Công đoạn"/>
                <field name="leader_id"/>
                <field name="member_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_dl_production_group_form" model="ir.ui.view">
        <field name="name">dl.production.group.form</field>
        <field name="model">dl.production.group</field>
        <field name="arch" type="xml">
            <form string="Tổ sản xuất">
                <header>
                    <button name="%(action_dl_employee_transfer)d" 
                            string="Điều chuyển nhân viên" 
                            type="action" 
                            class="btn-primary btn-lg"
                            context="{'default_to_group_id': id}"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" string="Tên Tổ sản xuất"/>
                        <h1>
                            <field name="name" placeholder="Ví dụ: Tổ Ép 1, Tổ Nhặt Ván..."/>
                        </h1>
                    </div>
                    
                    <group>
                        <group class="dl_card" string="Vị trí tổ chức">
                            <i class="fa fa-industry dl_field_icon" title="Xưởng"/>
                            <field name="x_workshop_id"/>
                            <i class="fa fa-cogs dl_field_icon" title="Công đoạn"/>
                            <field name="department_id" domain="[('x_workshop_id', '=', x_workshop_id)]"/>
                        </group>
                        <group class="dl_card" string="Nhân sự tổ">
                            <i class="fa fa-user-circle dl_field_icon" title="Tổ trưởng"/>
                            <field name="leader_id" widget="many2one_avatar_user"/>
                            <i class="fa fa-users dl_field_icon" title="Số lượng"/>
                            <field name="member_count"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Danh sách thành viên (Biên chế)" name="members">
                            <field name="x_employee_ids">
                                <list string="Thành viên" editable="bottom">
                                    <field name="barcode" string="Mã số" optional="show"/>
                                    <field name="name"/>
                                    <field name="job_id"/>
                                    <field name="work_phone"/>
                                    <field name="work_email" optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_dl_production_group" model="ir.actions.act_window">
        <field name="name">Tổ sản xuất</field>
        <field name="res_model">dl.production.group</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo tổ sản xuất mới!
            </p>
        </field>
    </record>
</odoo>
