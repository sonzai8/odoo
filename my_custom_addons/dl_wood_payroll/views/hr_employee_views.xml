<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_inherit_dl_payroll" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.dl.payroll</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Biên chế sản xuất" name="production_info">
                    <header>
                        <button name="%(action_dl_employee_transfer)d" 
                                string="Yêu cầu điều chuyển tổ" 
                                type="action" 
                                class="btn-primary"
                                context="{'default_employee_id': id, 'default_from_group_id': x_source_group_id}"/>
                    </header>
                    <div class="o_horizontal_separator text-primary mb-3">
                        <i class="fa fa-id-card me-1"/> VỊ TRÍ TỔ CHỨC
                    </div>
                    <group>
                        <group class="dl_card" string="Công đoạn &amp; Tổ đội">
                            <i class="fa fa-cogs dl_field_icon" title="Công đoạn"/>
                            <field name="department_id" string="Công đoạn sản xuất" options="{'no_create': True}"/>
                            <i class="fa fa-users dl_field_icon" title="Tổ sản xuất"/>
                            <field name="x_source_group_id"/>
                        </group>
                        <group class="dl_card" string="Phân loại">
                            <field name="x_is_daily_worker" widget="boolean_toggle"/>
                            <field name="job_id"/>
                        </group>
                    </group>
                    <div class="alert alert-info mt-3" role="alert" invisible="not x_source_group_id">
                        <i class="fa fa-info-circle me-2"/>
                        Nhân viên này thuộc biên chế chính thức của <b><field name="x_source_group_id" readonly="1" options="{'no_open': True}"/></b>.
                    </div>
                </page>
            </xpath>
        </field>
    </record>
    <record id="action_dl_employee_missing_attendance" model="ir.actions.server">
        <field name="name">Nhân viên thiếu công hôm nay</field>
        <field name="model_id" ref="model_hr_employee"/>
        <field name="state">code</field>
        <field name="code">
            action = model.action_view_missing_attendance()
        </field>
    </record>

    <!-- Update Employee Search View for easier grouping -->
    <record id="view_hr_employee_search_inherit_wood" model="ir.ui.view">
        <field name="name">hr.employee.search.inherit.wood</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='group_department']" position="after">
                <filter string="Tổ biên chế" name="group_by_source_group" context="{'group_by': 'x_source_group_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>
