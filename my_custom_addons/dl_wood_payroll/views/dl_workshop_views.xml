<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dl_workshop_tree" model="ir.ui.view">
        <field name="name">dl.workshop.tree</field>
        <field name="model">dl.workshop</field>
        <field name="arch" type="xml">
            <list string="Xưởng sản xuất">
                <field name="name"/>
                <field name="code"/>
                <field name="manager_id"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_dl_workshop_form" model="ir.ui.view">
        <field name="name">dl.workshop.form</field>
        <field name="model">dl.workshop</field>
        <field name="arch" type="xml">
            <form string="Xưởng sản xuất">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Ví dụ: Xưởng A, Xưởng sơ chế..."/>
                        </h1>
                    </div>
                    <group>
                        <group class="dl_card" string="Thông tin quản lý">
                            <field name="code"/>
                            <field name="manager_id" widget="many2one_avatar_user"/>
                        </group>
                        <group class="dl_card" string="Trạng thái">
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Công đoạn sản xuất (Bộ phận)" name="departments">
                            <field name="x_department_ids">
                                <list>
                                    <field name="name" string="Tên công đoạn"/>
                                    <field name="manager_id"/>
                                    <field name="total_employee"/>
                                </list>
                            </field>
                        </page>
                        <page string="Ghi chú" name="notes">
                            <field name="description" placeholder="Mô tả chi tiết về xưởng..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dl_workshop" model="ir.actions.act_window">
        <field name="name">Xưởng sản xuất</field>
        <field name="res_model">dl.workshop</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo xưởng sản xuất mới!
            </p>
        </field>
    </record>
</odoo>
