<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dl_film_type_tree" model="ir.ui.view">
        <field name="name">dl.film.type.tree</field>
        <field name="model">dl.film.type</field>
        <field name="arch" type="xml">
            <list string="Danh mục Loại Film" editable="bottom">
                <field name="code" decoration-bf="1"/>
                <field name="name"/>
                <field name="thickness" widget="float" digits="[16,2]"/>
                <field name="note" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_dl_film_type_form" model="ir.ui.view">
        <field name="name">dl.film.type.form</field>
        <field name="model">dl.film.type</field>
        <field name="arch" type="xml">
            <form string="Loại Film">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Tên loại Film"/>
                        <h1>
                            <field name="name" placeholder="Ví dụ: Film Việt Nam, Film Nâu Đen..."/>
                        </h1>
                    </div>
                    <group class="dl_card" string="Thông số cơ bản">
                        <group shadow="1">
                            <field name="code"/>
                            <div class="dl_row_units">
                                <label for="thickness"/>
                                <field name="thickness"/>
                                <span class="dl_unit_badge">mm</span>
                            </div>
                        </group>
                        <group>
                            <field name="note" placeholder="Ghi chú thêm..."/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dl_film_type" model="ir.actions.act_window">
        <field name="name">Quản lý loại Film</field>
        <field name="res_model">dl.film.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Thêm loại Film mới để quản lý thông số ván!
            </p>
        </field>
    </record>
</odoo>
