<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sale Order Line View Inheritance -->
    <record id="view_order_form_inherit_dl_wood" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.dl.wood</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='name']" position="after">
                <field name="x_structure_summary" string="Thông số" optional="show"/>
                <field name="x_thickness" optional="hide"/>
                <field name="x_length" optional="hide"/>
                <field name="x_width" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- Stock Picking (Stock Move) View Inheritance -->
    <record id="view_picking_form_inherit_dl_wood" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.dl.wood</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_ids_without_package']/list/field[@name='product_id']" position="after">
                <field name="x_structure_summary" string="Thông số" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Account Move Line (Invoice) View Inheritance -->
    <record id="view_move_form_inherit_dl_wood" model="ir.ui.view">
        <field name="name">account.move.form.inherit.dl.wood</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='name']" position="after">
                <field name="x_structure_summary" string="Thông số" optional="show"/>
                <field name="x_thickness" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
