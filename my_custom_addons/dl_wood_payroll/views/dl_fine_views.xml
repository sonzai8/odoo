<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Fine Reason Views -->
    <record id="view_dl_fine_reason_tree" model="ir.ui.view">
        <field name="name">dl.fine.reason.tree</field>
        <field name="model">dl.fine.reason</field>
        <field name="arch" type="xml">
            <list string="Lý do phạt" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="default_amount" widget="monetary"/>
            </list>
        </field>
    </record>

    <!-- Employee Fine Views -->
    <record id="view_dl_employee_fine_tree" model="ir.ui.view">
        <field name="name">dl.employee.fine.tree</field>
        <field name="model">dl.employee.fine</field>
        <field name="arch" type="xml">
            <list string="Danh sách phạt">
                <field name="name"/>
                <field name="date"/>
                <field name="employee_id" widget="many2one_avatar"/>
                <field name="reason_id"/>
                <field name="amount" sum="Tổng tiền phạt"/>
            </list>
        </field>
    </record>

    <record id="view_dl_employee_fine_form" model="ir.ui.view">
        <field name="name">dl.employee.fine.form</field>
        <field name="model">dl.employee.fine</field>
        <field name="arch" type="xml">
            <form string="Phiếu phạt">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Mẫu số"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" widget="many2one_avatar"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="reason_id" placeholder="Chọn lý do hoặc để trống nếu tự nhập..."/>
                            <field name="amount" widget="monetary"/>
                        </group>
                    </group>
                    <group string="Chi tiết vi phạm">
                        <field name="description" placeholder="Mô tả cụ thể hành vi vi phạm..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_dl_fine_reason" model="ir.actions.act_window">
        <field name="name">Cấu hình lý do phạt</field>
        <field name="res_model">dl.fine.reason</field>
        <field name="view_mode">list</field>
    </record>

    <record id="action_dl_employee_fine" model="ir.actions.act_window">
        <field name="name">Danh sách phạt</field>
        <field name="res_model">dl.employee.fine</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_date': 1}</field>
    </record>
</odoo>
