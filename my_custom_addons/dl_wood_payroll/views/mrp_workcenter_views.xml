<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_workcenter_view_inherit_dl_payroll" model="ir.ui.view">
        <field name="name">mrp.workcenter.view.inherit.dl.payroll</field>
        <field name="model">mrp.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_workcenter_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='alternative_workcenter_ids']" position="after">
                <group string="Cấu trúc nhân sự" name="hr_structure">
                    <field name="x_workshop_id"/>
                    <field name="x_is_nhat_van"/>
                </group>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Các Tổ sản xuất" name="production_groups">
                    <field name="x_production_group_ids">
                        <list string="Tổ sản xuất">
                            <field name="name"/>
                            <field name="leader_id"/>
                            <field name="member_count"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Thêm List View cho Công đoạn trong module này -->
    <record id="view_mrp_workcenter_list_dl" model="ir.ui.view">
        <field name="name">mrp.workcenter.list.dl</field>
        <field name="model">mrp.workcenter</field>
        <field name="arch" type="xml">
            <list string="Công đoạn">
                <field name="name"/>
                <field name="code"/>
                <field name="x_workshop_id"/>
                <field name="x_production_group_ids" string="Số lượng tổ" widget="handle"/>
            </list>
        </field>
    </record>

    <record id="action_dl_workcenter" model="ir.actions.act_window">
        <field name="name">Công đoạn (Work Center)</field>
        <field name="res_model">mrp.workcenter</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_mrp_workcenter_list_dl"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Quản lý các bước công đoạn sản xuất!
            </p>
        </field>
    </record>
</odoo>
