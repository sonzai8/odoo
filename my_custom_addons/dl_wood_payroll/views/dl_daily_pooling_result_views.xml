<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dl_daily_pooling_result_tree" model="ir.ui.view">
        <field name="name">dl.daily.pooling.result.tree</field>
        <field name="model">dl.daily.pooling.result</field>
        <field name="arch" type="xml">
            <list string="Kết quả cào bằng lương" create="false" edit="false">
                <field name="date"/>
                <field name="employee_id"/>
                <field name="source_group_id"/>
                <field name="actual_work_days" sum="Tổng công"/>
                <field name="native_contribution" sum="Tổng tại tổ" optional="show"/>
                <field name="borrowed_contribution" sum="Tổng mang về" optional="show"/>
                <field name="contribution_amount" sum="Tổng Yield"/>
                <field name="pool_unit_price"/>
                <field name="final_salary" sum="Tổng lương thực nhận"/>
                <field name="is_loaned_worker" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_dl_daily_pooling_result_pivot" model="ir.ui.view">
        <field name="name">dl.daily.pooling.result.pivot</field>
        <field name="model">dl.daily.pooling.result</field>
        <field name="arch" type="xml">
            <pivot string="Ma trận Lương ngày" sample="1">
                <field name="source_group_id" type="row"/>
                <field name="employee_id" type="row"/>
                <field name="date" interval="day" type="col"/>
                <field name="final_salary" type="measure"/>
                <field name="borrowed_contribution" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_dl_daily_pooling_result_search" model="ir.ui.view">
        <field name="name">dl.daily.pooling.result.search</field>
        <field name="model">dl.daily.pooling.result</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="source_group_id"/>
            </search>
        </field>
    </record>

    <record id="action_dl_daily_pooling_result" model="ir.actions.act_window">
        <field name="name">Kết quả cào bằng lương</field>
        <field name="res_model">dl.daily.pooling.result</field>
        <field name="view_mode">list,pivot,form</field>
        <field name="search_view_id" ref="view_dl_daily_pooling_result_search"/>
    </record>

    <record id="action_dl_payroll_matrix_report" model="ir.actions.act_window">
        <field name="name">Ma trận Lương ngày</field>
        <field name="res_model">dl.daily.pooling.result</field>
        <field name="view_mode">pivot,list</field>
        <field name="search_view_id" ref="view_dl_daily_pooling_result_search"/>
    </record>
</odoo>
