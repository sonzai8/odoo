<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Bảng giá Phơi ván -->
    <record id="view_dl_drying_pricelist_tree" model="ir.ui.view">
        <field name="name">dl.drying.pricelist.tree</field>
        <field name="model">dl.drying.pricelist</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="veneer_type"/>
                <field name="thickness"/>
                <field name="quality"/>
                <field name="unit_price"/>
            </list>
        </field>
    </record>

    <record id="action_dl_drying_pricelist" model="ir.actions.act_window">
        <field name="name">Bảng giá Phơi ván</field>
        <field name="res_model">dl.drying.pricelist</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Phiếu Nghiệm Thu Phơi Ván -->
    <record id="view_dl_veneer_drying_log_tree" model="ir.ui.view">
        <field name="name">dl.veneer.drying.log.tree</field>
        <field name="model">dl.veneer.drying.log</field>
        <field name="arch" type="xml">
            <list string="Nghiệm thu Phơi ván" editable="bottom" multi_edit="1">
                <field name="date"/>
                <field name="employee_id"/>
                <field name="veneer_type"/>
                <field name="thickness"/>
                <field name="quality"/>
                <field name="quantity"/>
                <field name="unit_price" optional="show"/>
                <field name="total_amount" sum="Tổng tiền" widget="monetary" decoration-bf="1"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'confirmed'"/>
                <button name="action_confirm" type="object" string="Xác nhận" icon="fa-check" invisible="state != 'draft'"/>
            </list>
        </field>
    </record>

    <record id="view_dl_veneer_drying_log_kanban" model="ir.ui.view">
        <field name="name">dl.veneer.drying.log.kanban</field>
        <field name="model">dl.veneer.drying.log</field>
        <field name="arch" type="xml">
            <kanban default_group_by="employee_id">
                <field name="employee_id"/>
                <field name="date"/>
                <field name="total_amount"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click container">
                            <div class="row">
                                <div class="col-8">
                                    <strong><field name="employee_id"/></strong>
                                </div>
                                <div class="col-4 text-end">
                                    <field name="date"/>
                                </div>
                            </div>
                            <div class="mt-2">
                                <span><field name="veneer_type"/> - <field name="thickness"/>ly - <field name="quality"/></span>
                            </div>
                            <div class="mt-1">
                                <strong><field name="total_amount" widget="monetary"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_dl_veneer_drying_log" model="ir.actions.act_window">
        <field name="name">Phiếu Nghiệm Thu Phơi Ván</field>
        <field name="res_model">dl.veneer.drying.log</field>
        <field name="view_mode">list,kanban,form</field>
    </record>
</odoo>
