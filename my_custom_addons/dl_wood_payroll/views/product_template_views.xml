<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Product Template Form Inheritance -->
    <record id="product_template_form_view_inherit_dl_payroll" model="ir.ui.view">
        <field name="name">product.template.form.inherit.dl.payroll</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <!-- Thêm cờ Tính lương vào nhóm tuỳ chọn -->
            <xpath expr="//div[@name='options']" position="inside">
                <span class="d-inline-block" invisible="context.get('x_hide_payroll_options')">
                    <field name="x_is_support_product"/>
                    <label for="x_is_support_product"/>
                </span>
                <span class="d-inline-block" invisible="context.get('x_hide_payroll_options')">
                    <field name="x_is_film_product"/>
                    <label for="x_is_film_product"/>
                </span>
            </xpath>
        </field>
    </record>

</odoo>
