<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Category -->
        <record id="module_category_dl_payroll" model="ir.module.category">
            <field name="name">DL Wood Payroll</field>
            <field name="description">Quản lý lương và đơn giá ngành gỗ</field>
            <field name="sequence">10</field>
        </record>

        <!-- Privilege for Odoo 19 -->
        <record id="privilege_dl_payroll" model="res.groups.privilege">
            <field name="name">DL Wood Payroll</field>
            <field name="category_id" ref="module_category_dl_payroll"/>
        </record>

        <!-- User group (Tổ trưởng) -->
        <record id="group_dl_wood_staff" model="res.groups">
            <field name="name">Tổ trưởng (Staff)</field>
            <field name="privilege_id" ref="privilege_dl_payroll"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Manager group (Quản lý xưởng) -->
        <record id="group_dl_wood_manager" model="res.groups">
            <field name="name">Quản lý Lương (Manager)</field>
            <field name="privilege_id" ref="privilege_dl_payroll"/>
            <field name="implied_ids" eval="[(4, ref('group_dl_wood_staff'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- Record Rules -->
        <record id="rule_dl_combined_log_staff" model="ir.rule">
            <field name="name">Tổ trưởng: Chỉ xem phiếu tổ mình</field>
            <field name="model_id" ref="model_dl_combined_log"/>
            <field name="domain_force">[('production_group_id.leader_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_dl_wood_staff'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_dl_combined_log_manager" model="ir.rule">
            <field name="name">Quản lý: Xem toàn bộ phiếu</field>
            <field name="model_id" ref="model_dl_combined_log"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_dl_wood_manager'))]"/>
        </record>

        <record id="rule_dl_daily_attendance_staff" model="ir.rule">
            <field name="name">Tổ trưởng: Chỉ xem chấm công tổ mình</field>
            <field name="model_id" ref="model_dl_daily_attendance"/>
            <field name="domain_force">[('production_group_id.leader_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_dl_wood_staff'))]"/>
        </record>

        <record id="rule_dl_daily_attendance_manager" model="ir.rule">
            <field name="name">Quản lý: Xem toàn bộ chấm công</field>
            <field name="model_id" ref="model_dl_daily_attendance"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_dl_wood_manager'))]"/>
        </record>

        <record id="rule_dl_daily_attendance_line_manager" model="ir.rule">
            <field name="name">Quản lý: Xem toàn bộ dòng chấm công</field>
            <field name="model_id" ref="model_dl_daily_attendance_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_dl_wood_manager'))]"/>
        </record>

        <record id="rule_dl_production_log_staff" model="ir.rule">
            <field name="name">Tổ trưởng: Chỉ xem sản lượng tổ mình</field>
            <field name="model_id" ref="model_dl_production_log"/>
            <field name="domain_force">[('production_group_id.leader_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_dl_wood_staff'))]"/>
        </record>

        <record id="rule_dl_production_log_manager" model="ir.rule">
            <field name="name">Quản lý: Xem toàn bộ sản lượng</field>
            <field name="model_id" ref="model_dl_production_log"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_dl_wood_manager'))]"/>
        </record>
    </data>
</odoo>