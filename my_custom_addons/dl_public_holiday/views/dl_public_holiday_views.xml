<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_dl_public_holiday_tree" model="ir.ui.view">
        <field name="name">dl.public.holiday.tree</field>
        <field name="model">dl.public.holiday</field>
        <field name="arch" type="xml">
            <list string="Ngày nghỉ lễ" decoration-muted="not active">
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="year"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_dl_public_holiday_form" model="ir.ui.view">
        <field name="name">dl.public.holiday.form</field>
        <field name="model">dl.public.holiday</field>
        <field name="arch" type="xml">
            <form string="Ngày nghỉ lễ">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Tên ngày lễ (VD: Tết Nguyên Đán)"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="year" invisible="1"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Ghi chú">
                            <field name="note" placeholder="Thêm ghi chú ở đây..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_dl_public_holiday_search" model="ir.ui.view">
        <field name="name">dl.public.holiday.search</field>
        <field name="model">dl.public.holiday</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm Ngày nghỉ lễ">
                <field name="name"/>
                <field name="year"/>
                <filter string="Đang áp dụng" name="active" domain="[('active', '=', True)]"/>
                <filter string="Đã lưu trữ" name="archived" domain="[('active', '=', False)]"/>
                <filter string="Năm" name="group_by_year" context="{'group_by':'year'}"/>
                <filter string="Công ty" name="group_by_company" context="{'group_by':'company_id'}"/>
                <searchpanel>
                    <field name="year" string="Năm" icon="fa-calendar"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_dl_public_holiday" model="ir.actions.act_window">
        <field name="name">Ngày nghỉ lễ</field>
        <field name="res_model">dl.public.holiday</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_dl_public_holiday_search"/>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Thêm ngày nghỉ lễ mới
            </p>
            <p>
                Quản lý danh sách các ngày nghỉ lễ trong năm. Dữ liệu này sẽ được các module khác sử dụng để loại trừ ngày nghỉ khi tính toán.
            </p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_dl_public_holiday_root"
              name="Ngày nghỉ lễ"
              web_icon="dl_public_holiday,static/description/icon.png"
              sequence="50"/>

    <menuitem id="menu_dl_public_holiday_list"
              name="Danh sách ngày lễ"
              parent="menu_dl_public_holiday_root"
              action="action_dl_public_holiday"
              sequence="10"/>

</odoo>
