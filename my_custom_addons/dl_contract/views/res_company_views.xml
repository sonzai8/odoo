<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_inherit_dl_contract" model="ir.ui.view">
        <field name="name">res.company.form.dl.contract</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Cấu hình Bảo hiểm" name="insurance_config">
                    <group string="Cấu hình khám chữa bệnh mặc định của Công ty">
                        <group>
                            <field name="x_kcb_state_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="x_kcb_hospital" placeholder="Ví dụ: Bệnh viện đa khoa huyện..."/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
