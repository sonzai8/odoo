<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Root menu -->
    <menuitem id="menu_dl_contract_root"
              name="Quản lý Hợp đồng"
              web_icon="dl_contract,static/description/icon.png"
              sequence="80"/>

    <!-- Danh sách nhân viên -->
    <record id="action_hr_employee_contracts" model="ir.actions.act_window">
        <field name="name">Danh sách Nhân viên</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">list,form,kanban</field>
    </record>

    <menuitem id="menu_dl_contract_employee"
              name="Danh sách Nhân viên"
              parent="menu_dl_contract_root"
              action="action_hr_employee_contracts"
              sequence="10"/>

    <!-- Hợp đồng lao động -->
    <record id="action_dl_contract" model="ir.actions.act_window">
        <field name="name">Hợp đồng Lao động</field>
        <field name="res_model">dl.contract</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo hợp đồng lao động đầu tiên
            </p>
        </field>
    </record>

    <menuitem id="menu_dl_contract_main"
              name="Hợp đồng Lao động"
              parent="menu_dl_contract_root"
              action="action_dl_contract"
              sequence="20"/>

    <!-- Số hoá Hợp đồng -->
    <menuitem id="menu_dl_digitize_contract"
              name="Số hoá Hợp đồng"
              parent="menu_dl_contract_root"
              action="action_dl_digitize_contract_wizard"
              groups="dl_contract.group_contract_manager"
              sequence="30"/>

    <!-- Tài liệu đã Số hoá -->
    <menuitem id="menu_dl_employee_scan_doc"
              name="Tài liệu đã Số hoá"
              parent="menu_dl_contract_root"
              action="action_dl_employee_scan_doc"
              groups="dl_contract.group_contract_manager"
              sequence="35"/>

    <!-- Cấu hình -->
    <menuitem id="menu_dl_contract_config"
              name="Cấu hình"
              parent="menu_dl_contract_root"
              groups="group_contract_manager"
              sequence="100"/>

    <!-- Loại hợp đồng -->
    <record id="action_dl_contract_type" model="ir.actions.act_window">
        <field name="name">Loại hợp đồng</field>
        <field name="res_model">dl.contract.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_dl_contract_type"
              name="Loại hợp đồng"
              parent="menu_dl_contract_config"
              action="action_dl_contract_type"
              sequence="10"/>

    <!-- Template hợp đồng -->
    <record id="action_dl_contract_template" model="ir.actions.act_window">
        <field name="name">Template hợp đồng</field>
        <field name="res_model">dl.contract.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_dl_contract_template"
              name="Template hợp đồng"
              parent="menu_dl_contract_config"
              action="action_dl_contract_template"
              sequence="20"/>

    <menuitem id="menu_dl_contract_states"
              name="Tỉnh / Thành Phố (Việt Nam)"
              parent="menu_dl_contract_config"
              action="action_res_country_state_vietnam_contract"
              sequence="50"/>

    <menuitem id="menu_dl_contract_wards"
              name="Xã / Phường (Việt Nam)"
              parent="menu_dl_contract_config"
              action="action_res_country_ward_contract"
              sequence="60"/>

    <!-- Khởi tạo dữ liệu -->
    <menuitem id="menu_dl_contract_init_data"
              name="Khởi tạo Dữ liệu mẫu"
              parent="menu_dl_contract_config"
              action="action_dl_contract_init_wizard"
              sequence="90"/>

    <!-- Quản lý Phòng ban -->
    <record id="action_dl_department_config" model="ir.actions.act_window">
        <field name="name">Phòng ban</field>
        <field name="res_model">hr.department</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo phòng ban đầu tiên
            </p>
        </field>
    </record>

    <menuitem id="menu_dl_department_config"
              name="Phòng ban"
              parent="menu_dl_contract_config"
              action="action_dl_department_config"
              sequence="30"/>

    <!-- Views cho dl.job.title -->
    <record id="view_dl_job_title_tree" model="ir.ui.view">
        <field name="name">dl.job.title.tree</field>
        <field name="model">dl.job.title</field>
        <field name="arch" type="xml">
            <list string="Chức danh công việc" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="department_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_dl_job_title_form" model="ir.ui.view">
        <field name="name">dl.job.title.form</field>
        <field name="model">dl.job.title</field>
        <field name="arch" type="xml">
            <form string="Chức danh công việc">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="department_id"/>
                            <field name="sequence"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Quản lý Chức danh -->
    <record id="action_dl_job_title_config" model="ir.actions.act_window">
        <field name="name">Chức danh</field>
        <field name="res_model">dl.job.title</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo chức danh đầu tiên
            </p>
        </field>
    </record>

    <menuitem id="menu_dl_job_title_config"
              name="Chức danh"
              parent="menu_dl_contract_config"
              action="action_dl_job_title_config"
              sequence="40"/>

</odoo>
