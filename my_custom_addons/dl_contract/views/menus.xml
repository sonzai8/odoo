<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Root menu -->
    <menuitem id="menu_dl_contract_root"
              name="Quản lý Hợp đồng"
              web_icon="dl_contract,static/description/icon.png"
              sequence="80"/>

    <!-- Danh sách nhân viên -->
    <record id="action_hr_employee_contracts" model="ir.actions.act_window">
        <field name="name">Danh sách Nhân viên</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">list,form,kanban</field>
    </record>

    <menuitem id="menu_dl_contract_employee"
              name="Danh sách Nhân viên"
              parent="menu_dl_contract_root"
              action="action_hr_employee_contracts"
              sequence="10"/>

    <!-- Hợp đồng lao động -->
    <record id="action_dl_contract" model="ir.actions.act_window">
        <field name="name">Hợp đồng Lao động</field>
        <field name="res_model">dl.contract</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo hợp đồng lao động đầu tiên
            </p>
        </field>
    </record>

    <menuitem id="menu_dl_contract_main"
              name="Hợp đồng Lao động"
              parent="menu_dl_contract_root"
              action="action_dl_contract"
              sequence="20"/>

    <!-- Cấu hình -->
    <menuitem id="menu_dl_contract_config"
              name="Cấu hình"
              parent="menu_dl_contract_root"
              groups="group_contract_manager"
              sequence="100"/>

    <!-- Loại hợp đồng -->
    <record id="action_dl_contract_type" model="ir.actions.act_window">
        <field name="name">Loại hợp đồng</field>
        <field name="res_model">dl.contract.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_dl_contract_type"
              name="Loại hợp đồng"
              parent="menu_dl_contract_config"
              action="action_dl_contract_type"
              sequence="10"/>

    <!-- Template hợp đồng -->
    <record id="action_dl_contract_template" model="ir.actions.act_window">
        <field name="name">Template hợp đồng</field>
        <field name="res_model">dl.contract.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_dl_contract_template"
              name="Template hợp đồng"
              parent="menu_dl_contract_config"
              action="action_dl_contract_template"
              sequence="20"/>

    <!-- Khởi tạo dữ liệu -->
    <menuitem id="menu_dl_contract_init_data"
              name="Khởi tạo Dữ liệu mẫu"
              parent="menu_dl_contract_config"
              action="action_dl_contract_init_wizard"
              sequence="90"/>

</odoo>
