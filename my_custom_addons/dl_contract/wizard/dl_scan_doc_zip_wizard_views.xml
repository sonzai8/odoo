<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dl_scan_doc_zip_wizard_form" model="ir.ui.view">
        <field name="name">dl.scan.doc.zip.wizard.form</field>
        <field name="model">dl.scan.doc.zip.wizard</field>
        <field name="arch" type="xml">
            <form string="Tải file Zip tài liệu scan">
                <div class="alert alert-success" role="alert">
                    Đã chuẩn bị file nén cho <field name="count" readonly="1" class="fw-bold"/> tài liệu. Vui lòng tải xuống bên dưới.
                </div>
                <group>
                    <field name="file_name" invisible="1"/>
                    <field name="file_data" filename="file_name" readonly="1" widget="binary"/>
                </group>
                <footer>
                    <button special="cancel" string="Đóng" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_dl_scan_doc_zip" model="ir.actions.act_window">
        <field name="name">Tải về (.zip)</field>
        <field name="res_model">dl.scan.doc.zip.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_dl_employee_scan_doc"/>
        <field name="binding_view_types">list</field>
    </record>
</odoo>
