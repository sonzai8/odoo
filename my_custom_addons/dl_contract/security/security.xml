<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record model="ir.module.category" id="module_category_dl_contract">
            <field name="name">Quản lý Hợp đồng</field>
            <field name="description">Quản lý hợp đồng lao động Đức Lâm</field>
            <field name="sequence">20</field>
        </record>

        <record model="res.groups.privilege" id="res_groups_privilege_dl_contract">
            <field name="name">Hợp đồng</field>
            <field name="category_id" ref="module_category_dl_contract"/>
        </record>

        <record id="group_contract_user" model="res.groups">
            <field name="name">Nhân viên xem hợp đồng</field>
            <field name="privilege_id" ref="res_groups_privilege_dl_contract"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Chỉ xem danh sách hợp đồng thuộc công ty mình.</field>
        </record>

        <record id="group_contract_manager" model="res.groups">
            <field name="name">Quản lý hợp đồng</field>
            <field name="privilege_id" ref="res_groups_privilege_dl_contract"/>
            <field name="implied_ids" eval="[(4, ref('group_contract_user'))]"/>
            <field name="comment">Tạo, sửa, xóa hợp đồng và template thuộc công ty mình.</field>
        </record>

        <!-- Multi-company Rules -->
        <record id="dl_contract_company_rule" model="ir.rule">
            <field name="name">Hợp đồng: Multi-company</field>
            <field name="model_id" ref="model_dl_contract"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="dl_contract_type_company_rule" model="ir.rule">
            <field name="name">Loại hợp đồng: Multi-company</field>
            <field name="model_id" ref="model_dl_contract_type"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="dl_salary_history_company_rule" model="ir.rule">
            <field name="name">Lịch sử lương: Multi-company</field>
            <field name="model_id" ref="model_dl_salary_history"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="dl_contract_template_company_rule" model="ir.rule">
            <field name="name">Template hợp đồng: Multi-company</field>
            <field name="model_id" ref="model_dl_contract_template"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
